CONFIG_SERIAL_8250_16550A_VARIANTS
CONFIG_SERIAL_8250_EXAR
CONFIG_SERIAL_8250_FSL
CONFIG_SERIAL_8250_LPSS
CONFIG_SERIAL_8250_MID
CONFIG_SERIAL_8250_PERICOM
CONFIG_SERIAL_8250_PNP

