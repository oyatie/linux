CONFIG_SLUB_CPU_PARTIAL
CONFIG_TRANSPARENT_HUGEPAGE_SHMEM_HUGE_NEVER
CONFIG_TRANSPARENT_HUGEPAGE_TMPFS_HUGE_NEVER

# Cheap passive observability (block debugfs, SLUB debug, hung-
