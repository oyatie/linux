# accept-defaults: reviewed default-on Kconfig features (the ledger half of
# "purposefully scoped").  `make audit` fails if any default-on feature is
# neither requested by a fragment, implied by a dependency, nor listed here.
# So the un-decided count in every shipped kernel is zero by construction.
# NOT a build input -- these are already on; this is the review record.
# Promptless internal plumbing is excluded (no human chooses it).

# Speculation mitigations + UMIP + TSX-off, all default-on -- which IS the
# intent (every mitigation compiled in; relax per-fleet on the command line,
# never in the image). Accepted not forced =y: the tail
# (ITS/TSA/VMSCAPE/SRBDS) is version-variable and forcing it makes the config
# fragile to symbol drift for nothing -- absent just means that CPU-class
# mitigation did not exist at that version.
CONFIG_MITIGATION_ITS
CONFIG_MITIGATION_RETBLEED
CONFIG_MITIGATION_SPECTRE_V1
CONFIG_MITIGATION_SPECTRE_V2
CONFIG_MITIGATION_SRBDS
CONFIG_MITIGATION_TSA
CONFIG_MITIGATION_UNRET_ENTRY
CONFIG_MITIGATION_VMSCAPE
CONFIG_X86_INTEL_TSX_MODE_AUTO
CONFIG_X86_INTEL_TSX_MODE_OFF
CONFIG_X86_UMIP

# mlx5 sub-features (steering/ARFS/RXNFC/MPFS/sampling) brought by the
# ConnectX driver we pin.
CONFIG_MLX5_EN_ARFS
CONFIG_MLX5_EN_RXNFC
CONFIG_MLX5_HW_STEERING
CONFIG_MLX5_MPFS
CONFIG_MLX5_SW_STEERING
CONFIG_MLX5_TC_SAMPLE

# GPU/RDMA defaults brought by GPU=amd|nvidia + hw-gpu-common on the training
# profile (amdgpu display-core, HSA SVM, RDMA on-demand paging, WMI, I2C
# helper).  Present only when a GPU is selected.
CONFIG_DRM_AMD_DC
CONFIG_HSA_AMD_SVM
CONFIG_I2C_HELPER_AUTO
CONFIG_INFINIBAND_ADDR_TRANS
CONFIG_INFINIBAND_ON_DEMAND_PAGING
CONFIG_WMI_BMOF

# erofs/squashfs/overlayfs/xfs sub-features for the verity root and scratch.
CONFIG_EROFS_FS_BACKED_BY_FILE
CONFIG_EROFS_FS_POSIX_ACL
CONFIG_EROFS_FS_SECURITY
CONFIG_EROFS_FS_XATTR
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW
CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE
CONFIG_SQUASHFS_FILE_CACHE
CONFIG_SQUASHFS_ZLIB
CONFIG_XFS_ONLINE_SCRUB_STATS

# Decompressor variants for initramfs/squashfs; small, kept for format
# flexibility.
CONFIG_XZ_DEC_ARM
CONFIG_XZ_DEC_ARM64
CONFIG_XZ_DEC_ARMTHUMB
CONFIG_XZ_DEC_POWERPC
CONFIG_XZ_DEC_RISCV
CONFIG_XZ_DEC_SPARC
CONFIG_XZ_DEC_X86

# 8250 UART variants -- kept: a console that fails to bind on some board is a
