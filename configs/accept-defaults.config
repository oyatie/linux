CONFIG_BQL
CONFIG_BRANCH_PROFILE_NONE
CONFIG_CRC_OPTIMIZATIONS
CONFIG_CRYPTO_HW
CONFIG_DEBUG_INFO_COMPRESSED_NONE
CONFIG_GENERIC_CALIBRATE_DELAY
CONFIG_LTO_NONE
CONFIG_PCPU_DEV_REFCNT

# Sub-options of already-requested subsystems (vhost knobs, KVM IOAPIC, VFIO,
# IOMMU perf, FUSE io_uring, firmware loader, etc.).
CONFIG_FUSE_IO_URING
CONFIG_FW_LOADER
CONFIG_INITRAMFS_PRESERVE_MTIME
CONFIG_INTEGRITY
CONFIG_INTEGRITY_AUDIT
CONFIG_INTEL_IOMMU_PERF_EVENTS
CONFIG_INTEL_IOMMU_SCALABLE_MODE_DEFAULT_ON
CONFIG_IOMMU_DEFAULT_DMA_LAZY
CONFIG_KVM_IOAPIC
CONFIG_NVMEM_SYSFS
CONFIG_PERF_EVENTS_INTEL_CSTATE
CONFIG_POWER_RESET
CONFIG_SCSI_LOWLEVEL
CONFIG_VHOST_ENABLE_FORK_OWNER_CONTROL


# CXL memory stack (hw-cxl) brings these default-on sub-features: EFI marks
# special-purpose / CXL memory as soft-reserved so it is not blindly used as
# ordinary RAM (presented as dax / onlined deliberately instead), and CXL gets
# its own PCIe AER error handling.  Accepted not forced -- PCIEAER_CXL is
# 6.18-era naming and is absent (implied) on the 7.2 track.
CONFIG_EFI_SOFT_RESERVE
CONFIG_PCIEAER_CXL

# Revealed by the per-profile scoped audit (the audit now passes only THIS
# profile's fragments as "requested," not every fragment in the tree).  These
# are default-on features that arrive with an enabled subsystem: the NIC vendor
# *menus* (default-on under NETDEVICES -- inert, no driver builds unless a
# fragment pins it via NICS=) and vsock's diag netlink.  (KVM_HYPERV was here
# too; it is now explicitly stripped in layer-hypervisor -- the design rejects
# that second hypercall ABI, so ratifying it as a default was wrong.)  Accepted, not forced.
CONFIG_NET_VENDOR_INTEL
CONFIG_NET_VENDOR_BROADCOM
CONFIG_NET_VENDOR_MELLANOX
CONFIG_VSOCKETS_DIAG

# arm64-specific default-on features (revealed by the scoped audit on the arm64
# tuples): EDAC's legacy sysfs interface (arrives with EDAC on metal) and the
# PTP-KVM guest clock (default-on with PTP + KVM).
CONFIG_EDAC_LEGACY_SYSFS
CONFIG_PTP_1588_CLOCK_KVM

# DMADEVICES-bringing accelerators (ACCEL=intel-dsa / intel-iaa, via INTEL_IDXD)
# turn on these default-on sub-features: the AMD CCP crypto offload (the CCP
# driver is already present for SEV on cpu=both) and 8250 UART DMA.  Accepted.
CONFIG_CRYPTO_DEV_SP_CCP
CONFIG_CRYPTO_DEV_CCP_CRYPTO
CONFIG_SERIAL_8250_DMA

# Enabling the CXL devdax path (hw-cxl: DAX/DEV_DAX/DEV_DAX_CXL) turns this on
# by itself -- DEV_DAX_HMEM is `default DEV_DAX` and EFI_SOFT_RESERVE is on, so
# it claims EFI soft-reserved ranges as dax devices.  Wanted: without it,
# non-CXL soft-reserved memory would be stranded.  Accepted, not forced (its
# default already follows DEV_DAX).
CONFIG_DEV_DAX_HMEM
