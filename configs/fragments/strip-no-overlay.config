# ---------------------------------------------------------------------------
# strip-no-overlay: for layers that are endpoints, not forwarding elements.
#
# The shared 30-net fragment carries a tenant dataplane: OVS, VXLAN/GENEVE
# encap, macvtap, ipvlan.  That exists because a hypervisor or worker
# terminates tenant traffic.  A control-plane or scheduler node originates and
# receives its own RPCs and forwards nothing -- for it, every one of these is
# a packet parser reachable from the network with no job to do.
#
# Kept deliberately: veth and bridge (CNI still plumbs pods on these nodes),
# nftables + conntrack (stateful host firewall), bonding (NIC redundancy).
# ---------------------------------------------------------------------------
# CONFIG_OPENVSWITCH is not set
# CONFIG_OPENVSWITCH_VXLAN is not set
# CONFIG_OPENVSWITCH_GENEVE is not set
# CONFIG_VXLAN is not set
# CONFIG_GENEVE is not set
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# CONFIG_IPVLAN is not set

# IPsec: east-west security on these layers is done by the RPC stack in
# userspace -- gRPC over TLS, or ALTS, depending on the fleet.  Either way the
# kernel never sees a plaintext record boundary, so kernel IPsec would be a
# second, redundant encryption layer that nobody audits and everybody pays
# for.  (Note this is also why kTLS does not belong on these layers: gRPC and
# ALTS both process records in userspace.)
# CONFIG_XFRM_USER is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_INET_ESP_OFFLOAD is not set

# AF_XDP and sockmap are dataplane accelerators.  A control-plane node running
# a consensus process has no packet-steering fast path to accelerate.
# CONFIG_XDP_SOCKETS is not set
# CONFIG_XDP_SOCKETS_DIAG is not set
