# Intel QuickAssist (QAT): crypto and compression offload.
#
# Worth having where the CPU cost of bulk symmetric crypto is measurable --
# NVMe-oF TLS, IPsec on a gateway, or compression on a storage path.  Not
# worth having for east-west RPC, whose TLS is terminated in userspace and
# never reaches the kernel crypto API.
#
#   make ACCEL=intel-qat PROFILE=worker build
CONFIG_CRYPTO_DEV_QAT=y
CONFIG_CRYPTO_DEV_QAT_4XXX=y
