# ---------------------------------------------------------------------------
# opt-debug: for a canary host or a bug you cannot reproduce anywhere else.
#
# NOT for the fleet: KASAN alone is a ~2-3x slowdown and doubles memory
# footprint, and lockdep serializes paths the hypervisor datapath depends on.
# ---------------------------------------------------------------------------
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_KASAN=y
CONFIG_KASAN_INLINE=y
CONFIG_KFENCE=y
CONFIG_PROVE_LOCKING=y
CONFIG_LOCK_STAT=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_LIST=y
CONFIG_KVM_PROVE_MMU=y
CONFIG_PROC_KCORE=y
