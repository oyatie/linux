# ---------------------------------------------------------------------------
# 00-core: CPU, scheduler, memory, cgroups, boot path.
#
# Architecture-neutral.  Per-arch machinery (MCE vs RAS extensions, APIC vs
# GIC, MAXSMP vs NR_CPUS, the console UART) lives in 00-core.<arch>.config,
# appended automatically by build.sh for the target arch.
#
# Baseline is `allnoconfig`, so *everything* here is an explicit decision.
# Symbols that are "default y under EXPERT" (epoll, futex, ...) must be
# turned on by hand -- allnoconfig does not give them to us for free.
# ---------------------------------------------------------------------------

# EXPERT unhides the "... if EXPERT" prompts.  Without it, symbols like VT,
# PNP and MODIFY_LDT_SYSCALL are not user-selectable and Kconfig silently
# applies their `default y` -- i.e. you cannot strip them at all.
CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
# Past 512 CPUs the cpumasks must move off the stack, and CPUMASK_OFFSTACK is
# only reachable via MAXSMP -- which then pins NR_CPUS to 8192 and drops its
# prompt.  Not theoretical: a 2-socket Turin host is 768 threads, so a
# 512-CPU kernel will not boot the top SKUs.  Cost is heap-allocated cpumasks.
# (MAXSMP depends on DEBUG_KERNEL, set in 60-observability.config.)
# CONFIG_X86_MCE_INJECT is not set
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# --- Scheduler / tick -------------------------------------------------------
# nohz_full + rcu_nocbs is how vCPU threads get an interruption-free CPU.
# Which CPUs are isolated is a boot-time decision (see docs/TUNING.md), not a
# build-time one.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_CPU_ISOLATION=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
CONFIG_IRQ_TIME_ACCOUNTING=y
# Lazy preemption: throughput of PREEMPT_NONE with a bounded latency tail,
# which is what a vCPU thread wants.  x86 dropped the VOLUNTARY option once
# ARCH_HAS_PREEMPT_LAZY landed.  PREEMPT_DYNAMIC keeps preempt= tunable at
# boot so a latency-sensitive fleet can move without a rebuild.
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_CORE=y
CONFIG_SCHEDSTATS=y
# Utilization clamping: lets the control plane tell the scheduler that a task
# is latency-sensitive (clamp min, so it does not sit at a low OPP) or batch
# (clamp max).  Without it, cpu.weight is the only lever and it says nothing
# about frequency or placement urgency.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# RT_GROUP_SCHED is deliberately absent: nothing here runs SCHED_FIFO/RR
# workloads, and the per-cgroup RT bandwidth machinery is cost without a user.
# Note SCHED_FIFO/SCHED_RR themselves need no config -- POSIX realtime
# scheduling is unconditional; what is configurable is only how it is bounded.
# CONFIG_RT_GROUP_SCHED is not set

# --- cgroup v2 --------------------------------------------------------------
# v2 only.  The v1 hierarchies are dead weight and a second, weaker policy
# surface; nothing in a modern VMM control plane needs them.
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_HUGETLB=y
# CGROUP_DEVICE is the *v1* device controller.  On v2, device access is
# enforced with BPF (CGROUP_BPF, which is on), and systemd/containerd use that
# path.  Shipping it here would be v1 code on a kernel that disables v1.
# CONFIG_CGROUP_DEVICE is not set
# CGROUP_FREEZER is the *v1* freezer controller -- its own help text says
# "affects the ORIGINAL cgroup interface".  v2's cgroup.freeze is core cgroup
# code and needs no symbol.  Fifth v1 controller found by the audit.
# CONFIG_CGROUP_FREEZER is not set
CONFIG_CGROUP_MISC=y
CONFIG_CGROUP_BPF=y
CONFIG_PSI=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_TASK_XACCT=y
# CONFIG_MEMCG_V1 is not set
# CONFIG_PSI_DEFAULT_DISABLED is not set

# --- Namespaces (VMM sandboxing, on-host agents) ----------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y

# --- Syscall surface a VMM actually uses ------------------------------------
CONFIG_MULTIUSER=y
# SYSVIPC is deliberately absent.  The audit trail called it the weakest keep
# in the tree: modern VMMs and services use memfd/POSIX shm, and nothing in
# the v1 plant needs System V IPC.  Re-add per fleet if a measured datastore
# demands it.
# CONFIG_SYSVIPC is not set
# POSIX message queues stay: the modern IPC primitive, and -- found by the
# checker when SYSVIPC left -- the LAST remaining satisfier of IPC_NS's
# dependency (SYSVIPC || POSIX_MQUEUE).  Cutting both would silently delete
# the IPC namespace that every container runtime unshares.
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_KCMP=y
CONFIG_USERFAULTFD=y
CONFIG_ELF_CORE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_SYSCTL=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_JUMP_LABEL=y

# --- Memory management ------------------------------------------------------
# No swap: a hypervisor host that swaps guest memory has already failed its
# latency SLO.  Guest RAM is hugetlbfs or THP, never anonymous+swap.
# CONFIG_SWAP is not set
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
# ...and actually on.  Without DEFAULT_ON the optimization is compiled in but
# dormant unless hugetlb_free_vmemmap=on is on every machine's command line,
# which is exactly the kind of claim that quietly turns out to be false.
CONFIG_SPARSEMEM_VMEMMAP=y
# Parallel struct page init: tens of seconds off boot on a multi-TB host, and
# boot time is fleet capacity during a mass reboot.  (On <= 6.18 this was
# mutually exclusive with KHO; above the MSV floor it is not.)
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_MEMORY_FAILURE=y
# (MMU_NOTIFIER is promptless -- selected by KVM and by the IOMMU drivers.
# Asking for it here did nothing; it appeared set only because something else
# selected it, and vanished in a VM with neither.)
# KSM deduplicates across security domains.  Not on a multi-tenant host.
# CONFIG_KSM is not set

# --- Boot -------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set

# --- Console: serial only, no VT ------------------------------------------
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_EARLYCON=y
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
