# ---------------------------------------------------------------------------
# layer-ch-guest: the general guest under Cloud Hypervisor.
#
# Sold VMs and first-party serving.  Deliberately NOT minimal: it inherits the
# full base (NUMA, MAXSMP's NR_CPUS, XFS/ext4, nftables, BPF, io_uring, kdump)
# because a general-purpose machine that happens to be virtual is still a
# general-purpose machine.  The minimal guest is fc-guest.
#
# PLATFORM=vm (applied before this layer) supplies kvm-clock, paravirt
# spinlocks, ptp_kvm, balloon, vsock and virtio-rng, and strips the bare-metal
# platform stack.  This layer adds back the few pieces Cloud Hypervisor
# really does provide to its guests.
# ---------------------------------------------------------------------------

# --- Device hotplug ---------------------------------------------------------
# Attaching a disk or NIC to a running VM is a sold feature.  Cloud Hypervisor
# signals hotplug through ACPI (GED), and the guest needs the ACPI PCI hotplug
# path that platform-vm strips as "the host's problem" -- here the VMM
# genuinely provides it.
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_ACPI_PCI_SLOT=y

# --- virtio-fs --------------------------------------------------------------
# Shared directories from the host (FUSE_FS comes from the storage base).
CONFIG_VIRTIO_FS=y

# --- virtio-iommu -----------------------------------------------------------
# DMA protection for the guest's own devices, and the prerequisite for nested
# device assignment.  Needs the IOMMU core back (platform-vm strips it because
# a guest has no VT-d/AMD-Vi -- virtio-iommu is the paravirt replacement).
CONFIG_IOMMU_SUPPORT=y
CONFIG_VIRTIO_IOMMU=y

# --- kTLS -------------------------------------------------------------------
# Already =y from the storage base (NVMe-oF TLS); restated because on this
# profile it is also the point: guest userspace (nginx/envoy with kTLS)
# terminates TLS through the kernel.  There is no TLS_DEVICE here -- a virtio
# NIC offloads nothing.
CONFIG_TLS=y

# --- MGLRU: multi-generational LRU -----------------------------------------
# Better page reclaim under memory pressure on a general-purpose guest.
# _ENABLED makes it the boot default (else compiled in but dormant behind a
# sysfs toggle).  Depends only on 64BIT (from base) -- a general mm feature.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Deliberately absent: virtio-mem (memory resize is balloon-only in v1; add
# CONFIG_VIRTIO_MEM plus MEMORY_HOTPLUG when elastic memory becomes a SKU),
# and VIRTIO_MMIO -- CH guests are virtio-pci.
