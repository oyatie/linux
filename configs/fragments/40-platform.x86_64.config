# x86_64 platform drivers: VT-d/AMD-Vi, vendor EDAC, PC-platform telemetry.
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_EDAC_SKX=y
CONFIG_EDAC_I10NM=y
CONFIG_EDAC_IGEN6=y
CONFIG_EDAC_AMD64=y
CONFIG_ITCO_WDT=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_INTEL_IDLE=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_INTEL_RAPL=y
CONFIG_X86_ACPI_CPUFREQ=y
# The corrected-error collector rides the x86 MCE machinery (depends X86_MCE);
# arm64's corrected-error path is APEI/GHES from the shared fragment.
CONFIG_RAS_CEC=y
