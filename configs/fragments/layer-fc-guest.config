# ---------------------------------------------------------------------------
# layer-fc-guest: the Firecracker guest -- no PCI, no ACPI, no EFI.
#
# This is the Firecracker shape.  Devices are declared on the kernel
# command line as virtio-mmio transports, so the guest never enumerates a PCI
# bus and never parses (or interprets) an ACPI table.
#
# The win is not mainly size, it is boot latency and surface:
#   - no PCI bus scan, no config-space probing, no MSI setup;
#   - no ACPI table parsing and no AML interpreter in the guest;
#   - no EFI stub, no runtime services, no variable store.
#
# The cost is that this kernel boots ONLY under a VMM that speaks
# virtio-mmio and the bare Linux boot protocol.  It will not boot on q35, on
# a cloud instance, or on metal.  That is the trade, and it is why this is a
# separate profile rather than a tweak to `microvm`.
# ---------------------------------------------------------------------------

CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# Devices come from the command line: virtio_mmio.device=4K@0xd0000000:5
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# Serial console at the legacy 0x3f8 port -- the one thing a microVM keeps.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- CPU time accounting: simple tick, not full-dynticks -------------------
# The base (00-core) selects VIRT_CPU_ACCOUNTING_GEN, which only earns its
# keep under NO_HZ_FULL: it pulls in CONTEXT_TRACKING_USER and taxes every
# user<->kernel crossing.  This guest is NO_HZ_IDLE (set by strip-minimal-
# guest, an OVERRIDES fragment applied after this layer), so that machinery
# is pure cost.  Switch the cputime *choice* to tick-based accounting.
#
# This is a Kconfig CHOICE override, so -- exactly as layer-hypervisor does
# for DEFAULT_CUBIC -> DEFAULT_DCTCP -- we must explicitly unset the base's
# chosen member so check-config's last-wins intent matches the resolved
# .config (otherwise it still expects VIRT_CPU_ACCOUNTING_GEN=y and flags a
# mismatch).  TICK_CPU_ACCOUNTING depends on !NO_HZ_FULL, which holds here.
# CONFIG_VIRT_CPU_ACCOUNTING_GEN is not set
CONFIG_TICK_CPU_ACCOUNTING=y
