# NVIDIA GPUs for compute (CUDA).
#
# nvidia.ko and nvidia-uvm.ko are out-of-tree and always will be, so this
# fleet cannot run a monolithic kernel.  Signature enforcement is the entire
# defence and the signing key must be held offline.
#
# What is NOT here is the point: no CONFIG_DRM.  Compute does not need it, and
# a headless training node has no display.  Only a node using nvidia-drm
# modeset or running graphics workloads needs DRM, and that node should say so
# explicitly rather than inheriting it.
#
#   make PROFILE=gpu-node GPU=nvidia build
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_DRM is not set
