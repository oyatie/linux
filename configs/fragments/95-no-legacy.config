# ---------------------------------------------------------------------------
# 95-no-legacy: hardware and options that have no place in a modern
# datacenter, but which Kconfig turns on by default.
#
# This fragment exists because of an audit finding, not a hunch: of ~1600
# enabled symbols in a profile, ~480 were never named by any fragment.  They
# arrived from Kconfig defaults.  Roughly half of those are internal plumbing;
# the rest are real features that switched themselves on, and this is the
# sweep of the ones that should not have.
#
# Regenerate the evidence with:  make unaudited PROFILE=hypervisor
# ---------------------------------------------------------------------------

# --- Laptop and workstation ACPI -------------------------------------------
# There is no battery, no lid, and no fan this kernel should be managing --
# chassis thermals belong to the BMC.
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_DEBUG is not set
# CONFIG_ACPI_REV_OVERRIDE_POSSIBLE is not set
# CONFIG_ACPI_I2C_OPREGION is not set
# ACPI PRM runs firmware-provided code in the kernel's context.  No.
# CONFIG_ACPI_PRMT is not set

# --- Intel Management Engine ------------------------------------------------
# The ME is the thing a datacenter operator disables in firmware; exposing a
# driver interface to it from the host kernel is the opposite of the posture.
# CONFIG_INTEL_MEI is not set
# CONFIG_INTEL_MEI_ME is not set

# --- Legacy x86 CPU vendors ---
# The per-vendor symbols only become selectable when PROCESSOR_SELECT opens
# the menu.  Without it, the strips below are silently ignored -- which is
# exactly the failure mode this whole fragment exists to catch.
# The fleet is Intel and AMD.  Centaur/Zhaoxin/Hygon support is dead code that
# still participates in early CPU identification and mitigation selection.
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# CONFIG_CPU_SUP_HYGON is not set

# --- Legacy storage ---------------------------------------------------------
# AHCI does not need the SFF/BMDMA layer -- that is PATA/IDE-era code.
# CONFIG_ATA_SFF is not set
# CONFIG_ATA_BMDMA is not set
# CONFIG_ATA_FORCE is not set
# CONFIG_ATA_VERBOSE_ERROR is not set
# SCSI generic passthrough: a raw command channel to the drive.
# CONFIG_BLK_DEV_BSG is not set
# UEFI-only fleet: GPT is the only partition scheme, so the MBR parser is a
# parser we never need to run.  Same gating trick as the CPU vendors above.
CONFIG_PARTITION_ADVANCED=y
# CONFIG_MSDOS_PARTITION is not set
# ext2 via the ext4 driver -- nothing here writes ext2.
# CONFIG_EXT4_USE_FOR_EXT2 is not set
# One decompressor (zstd) is enough; each extra one is a parser.
# CONFIG_EROFS_FS_ZIP_LZMA is not set

# --- Legacy networking ------------------------------------------------------
# SIT is IPv6-in-IPv4 transition tech from the 2000s.
# CONFIG_IPV6_SIT is not set
# The NFS/CIFS menu, with nothing in it.
# CONFIG_NETWORK_FILESYSTEMS is not set
# IPsec offload on a NIC, where IPsec itself is not the encryption story.
# CONFIG_IXGBE_IPSEC is not set

# --- Misc surface -----------------------------------------------------------
# Device/firmware coredumps dumped through the kernel.
# CONFIG_ALLOW_DEV_COREDUMP is not set
# Obsolete algorithms exposed through AF_ALG.
# CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE is not set
# VIA padlock RNG on an Intel/AMD fleet.
# CONFIG_HW_RANDOM_VIA is not set
# FUSE passthrough hands a FUSE server direct access to the backing file.
# CONFIG_FUSE_PASSTHROUGH is not set
# CONFIG_DEBUG_MISC is not set
# Port-0x80 I/O delay, for hardware that predates this century.
# CONFIG_IO_DELAY_0X80 is not set

# --- Decisions that were riding defaults ------------------------------------
# These stay on, but they are now decisions rather than inheritances.
# Offline a core the RAS path has condemned.
CONFIG_HOTPLUG_CPU=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# kvm_stat and the KVM debugfs counters need it.
CONFIG_DEBUG_FS_ALLOW_ALL=y
CONFIG_EFI_PARTITION=y
# Kept, but see docs/TUNING.md: RLIMIT_CORE=0 on hosts, because a VMM core
# dump *is* guest memory written to disk.
CONFIG_COREDUMP=y
# Call-depth tracking costs real throughput on Skylake-era parts and the
# design doc already said it was off.  Now it actually is.
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set

# --- NIC vendors we do not buy ---------------------------------------------
# Menu gates, so mostly zero code -- but leaving ~70 vendor menus open is how
# a future `select` quietly pulls a driver in.  "No compatibility drivers",
# stated rather than assumed.
# CONFIG_NET_VENDOR_3COM is not set
# CONFIG_NET_VENDOR_8390 is not set
# CONFIG_NET_VENDOR_ADAPTEC is not set
# CONFIG_NET_VENDOR_AGERE is not set
# CONFIG_NET_VENDOR_ALACRITECH is not set
# CONFIG_NET_VENDOR_ALIBABA is not set
# CONFIG_NET_VENDOR_AMAZON is not set
