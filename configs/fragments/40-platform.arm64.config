# arm64 platform drivers.
# The IOMMU is SMMUv3; the strict-invalidation default in the shared fragment
# applies to it identically.
CONFIG_ARM_SMMU_V3=y
# Frequency control on ACPI arm64 servers is CPPC.
CONFIG_ACPI_CPPC_CPUFREQ=y
# Entropy: platform RNG via SMCCC/TRNG firmware call and the CPU RNDR
# instruction are both picked up by the core; no vendor driver needed.
