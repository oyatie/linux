# ---------------------------------------------------------------------------
# layer-microvm: the kernel that runs *inside* a VM, not the one that hosts it.
#
# Firecracker/crosvm-class guest: one workload, virtio devices, no physical
# hardware, no tenants of its own.  This is the profile people mean when they
# quote a ~5MB kernel -- it is a fundamentally easier problem than a host
# kernel, because everything a host must cope with (real NICs, memory errors,
# out-of-band management, power, other people's VMs) is someone else's job.
#
# Paired with PLATFORM=vm, which supplies the guest paravirt bits and removes
# the bare-metal platform stack.
# ---------------------------------------------------------------------------

CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
