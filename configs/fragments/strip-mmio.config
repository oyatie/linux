# ---------------------------------------------------------------------------
# strip-mmio: remove the buses a microVM does not have.
#
# Applied after strip-host.  Everything here exists to serve hardware
# discovery, and this guest discovers nothing: its devices are on the kernel
# command line.
# ---------------------------------------------------------------------------
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_SERIAL_8250_PCI is not set
# CONFIG_RTC_DRV_CMOS is not set
# A guest does not handle machine checks; the host owns the hardware, and a
# guest that thinks it can recover a memory error is a guest that disagrees
# with its hypervisor about who owns the page.
# CONFIG_X86_MCE is not set
# CONFIG_X86_MCE_INTEL is not set
# CONFIG_X86_MCE_AMD is not set
# CONFIG_X86_MCE_THRESHOLD is not set
# MEMORY_FAILURE depends on MCE on x86, and follows it out.
# CONFIG_MEMORY_FAILURE is not set

# HPET stays: it is selected rather than chosen, and a microVM still wants a
# calibration source before kvm-clock takes over.

# --- Consequences of removing PCI ------------------------------------------
# CONFIG_PCI_MSI is not set
# CONFIG_PCIEPORTBUS is not set
# CONFIG_PCIE_PME is not set
# CONFIG_PCI_QUIRKS is not set
# CONFIG_VIRTIO_PCI_LEGACY is not set
# The RNG and the uncore/RAPL PMUs are all PCI-attached host hardware.
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set

# --- Consequences of removing ACPI -----------------------------------------
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_CPPC_LIB is not set
# CONFIG_ACPI_HED is not set
# CONFIG_ACPI_PCI_SLOT is not set
# CONFIG_ACPI_PROCESSOR is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_X86_AMD_PSTATE is not set
# CONFIG_X86_ACPI_CPUFREQ is not set

# --- Consequences of removing EFI ------------------------------------------
# CONFIG_EFIVAR_FS is not set
# CONFIG_EFI_RUNTIME_WRAPPERS is not set
