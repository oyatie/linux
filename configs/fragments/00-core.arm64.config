# arm64 side of 00-core: Graviton/Ampere/Grace-class servers.
CONFIG_ARM64=y
# No MAXSMP on arm64; 512 covers the current server ceiling (Ampere 192,
# Grace 144 per socket) and Kconfig moves cpumasks offstack above 256 itself.
CONFIG_NR_CPUS=512
# 4K pages: the compatible default for sold VMs (a 64K-page host cannot run
# 4K-page guests' hugetlb expectations cleanly, and userspace ecosystems
# still assume 4K).  A storage-heavy first-party fleet may want 64K -- that
# would be a separate SKU decision, not a flip here.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# The server console: PL011 / SBSA UART.  (8250 stays in the shared base for
# the odd platform that has one; it is harmless.)
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# Firmware-driven CPU control.
CONFIG_ARM_PSCI_CPUIDLE=y
# RAS on arm64 arrives via ACPI GHES/APEI (shared 40-platform) rather than a
# vendor MCE bank; the ARM RAS extension nodes feed the same path.
CONFIG_ARM64_RAS_EXTN=y
