# ---------------------------------------------------------------------------
# opt-diag: in-kernel simulation/injection frameworks for testing driver and
# RAS paths WITHOUT the hardware -- the industry-standard emulation bypasses.
# Test/CI kernels only; never a production image (these are attack surface and
# footguns by design).
# ---------------------------------------------------------------------------
# netdevsim: simulate SR-IOV VF create/delete/config and switchdev without a
# real NIC -- how SR-IOV orchestrators are tested.
CONFIG_NETDEVSIM=y
# virtio-net failover pair: the driver stack behaves like mlx5 bonding
# failover, so VF-live-migration control loops can be tested in pure software.
CONFIG_FAILOVER=y
CONFIG_NET_FAILOVER=y
# Block-layer fault injection (make_request) for storage error-path testing.
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAIL_MAKE_REQUEST=y
