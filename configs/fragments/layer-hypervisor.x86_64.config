# x86_64 hypervisor: vendor KVM, SMM for OVMF/SeaBIOS firmware, and the
# confidential-computing host stacks.
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_MAX_NR_VCPUS=1024
CONFIG_KVM_SMM=y
# AMD SEV/SEV-ES/SEV-SNP (the CCP/PSP mailbox driver is what makes it real).
CONFIG_KVM_AMD_SEV=y
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_SP_PSP=y
# Intel TDX host (CMA for the module comes from the shared layer).
CONFIG_INTEL_TDX_HOST=y
CONFIG_KVM_INTEL_TDX=y
