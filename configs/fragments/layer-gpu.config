# ---------------------------------------------------------------------------
# layer-gpu: accelerator node for AI training / HPC.
#
# The shape is different enough from a general worker to deserve its own
# layer: a small number of very large jobs, each spanning every GPU on the
# machine and every machine in the rail, where the interconnect is the
# bottleneck and a single straggler stalls a whole collective.
#
# Three things follow from that, and they are what this fragment is:
#
#   1. RDMA is the fabric, not TCP.  GPU-to-GPU traffic goes over
#      InfiniBand/RoCE with the CPU out of the path entirely.
#   2. GPUDirect needs peer-to-peer DMA between PCIe devices, so the NIC can
#      read GPU memory without bouncing through host RAM.
#   3. The vendor GPU driver is out-of-tree, which forces the module loader
#      back -- signed, as always.
# ---------------------------------------------------------------------------

# --- Fabric -----------------------------------------------------------------
CONFIG_INFINIBAND=y
CONFIG_INFINIBAND_USER_ACCESS=y
CONFIG_INFINIBAND_USER_MAD=y
CONFIG_MLX5_INFINIBAND=y
# CONFIG_RDMA_RXE is not set

# --- GPUDirect --------------------------------------------------------------
# Peer-to-peer DMA between PCIe endpoints: the NIC DMAs straight into GPU
# memory.  Without it every collective takes an extra trip through host RAM
# and the interconnect stops being the bottleneck the hardware was sized for.
#
# The dependency chain is worth stating, because it drags in something the
# other profiles deliberately refuse: PCI_P2PDMA needs ZONE_DEVICE, which
# needs MEMORY_HOTPLUG and MEMORY_HOTREMOVE.  So a GPU node carries the memory
# hotplug machinery purely to be able to map device memory -- it is not there
# because anyone hot-adds DIMMs.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_PCI_P2PDMA=y
# dma-buf sharing (DMA_SHARED_BUFFER) is selected by the drivers that need it;
# there is no user-visible DMABUF_MOVE_NOTIFY in 7.2.

# --- Vendor driver ----------------------------------------------------------
# Deliberately NOT here.  The vendor choice changes the kernel's shape so much
# that it cannot be a detail inside a shared fragment:
#
#   NVIDIA  -- out-of-tree modules, no in-tree DRM needed for compute.
#   AMD     -- in-tree amdgpu, which means CONFIG_DRM, the single largest
#              subsystem 90-strip.config exists to remove.
#
# So it is a per-fleet selection like the NICs:  GPU=nvidia | GPU=amd
# See configs/fragments/hw-gpu-*.config.

# --- Memory -----------------------------------------------------------------
# Training jobs pin enormous buffers and are exquisitely NUMA-sensitive: a
# tensor allocated on the wrong socket costs an interconnect hop on every
# step.  Placement is explicit, so the kernel's balancer must not second-guess
# it (kernel.numa_balancing=0 -- see docs/TUNING.md).
CONFIG_NUMA=y
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
# Cache/bandwidth partitioning matters here for the same reason it does on a
# worker: a data-loader thread should not evict the training process's
# working set.
CONFIG_X86_CPU_RESCTRL=y
