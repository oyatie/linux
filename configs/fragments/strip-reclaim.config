# strip-reclaim: reclaim is fenced + single-purpose.  Conservative strip -- only
# subsystems nothing else in the tree selects.  Deeply-wired host features
# (kexec signing, BPF LSM, perf, RAS/APEI) stay: other base fragments depend on
# them, and a full teardown is a separate refactor.  (OVERRIDES => last wins.)

# --- NVMe over fabrics: reclaim wipes the LOCAL PCIe drive; no net storage ---
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_TCP_TLS is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_MULTIPATH is not set
# CONFIG_NVME_HWMON is not set

# --- BTF: no eBPF CO-RE on a wipe kernel (drops the whole BTF blob) ----------
# CONFIG_DEBUG_INFO_BTF is not set

# --- EDAC: a box being wiped is not monitored for ECC trends ----------------
# CONFIG_EDAC is not set
# CONFIG_EDAC_GHES is not set

# --- leaf tracers: trace features with no in-tree selectors ------------------
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_SCHED_TRACER is not set
# CONFIG_HIST_TRIGGERS is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
