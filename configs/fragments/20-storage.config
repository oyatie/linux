# ---------------------------------------------------------------------------
# 20-storage: block layer, local NVMe, remote NVMe, filesystems.
#
# Filesystem policy: a read-only verity-protected root image (erofs or
# squashfs) + overlayfs + tmpfs, plus ext4/xfs for the local scratch that
# holds guest disk images.  Nothing else is mountable, which also means
# nothing else is an attack surface reachable by handing the host a crafted
# image.
# ---------------------------------------------------------------------------

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y
CONFIG_BLK_DEV_INTEGRITY=y
# Self-encrypting drives: key management in the drive, no CPU cost on the
# data path.  Complements dm-crypt rather than replacing it -- Opal protects
# data at rest against drive removal, dm-crypt protects it against the next
# tenant.
CONFIG_BLK_SED_OPAL=y
# Zoned/ZNS namespaces: enable per fleet if you buy ZNS parts.  Off here
# because a zoned block device that nothing understands is worse than absent.
# CONFIG_BLK_DEV_ZONED is not set
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BLK_DEV_RAM is not set

# --- NVMe: local and fabrics ------------------------------------------------
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y
CONFIG_NVME_FABRICS=y
CONFIG_NVME_TCP=y
# NVME_FABRICS is only the common layer -- discovery, the connect/keep-alive
# state machine, the /dev/nvme-fabrics uAPI.  It carries no transport, so with
# every transport stripped it resolves to =y, passes the symbol-by-symbol check
# above, and attaches to exactly nothing.  Say so, so a later fragment that
# drops NVME_TCP fails the build instead of shipping a fabrics stack that
# cannot reach a target.  (See the ASSERT-ANY/ASSERT-ALL note in
# scripts/check-config.sh.)
# ASSERT-ANY: CONFIG_NVME_FABRICS => CONFIG_NVME_TCP CONFIG_NVME_RDMA CONFIG_NVME_FC

# kTLS lives here, not in the networking fragment, because NVMe-oF/TCP is the
# thing in this kernel that actually consumes it: TLS 1.3 for fabrics runs
# through the kernel TLS stack via the netlink handshake API.
#
# It is explicitly NOT here for east-west RPC.  gRPC does its record
# processing in userspace (Go crypto/tls, BoringSSL), and ALTS is not TLS
# records at all -- neither kTLS nor NIC TLS offload can touch either.
CONFIG_TLS=y
CONFIG_NVME_TCP_TLS=y
# CONFIG_TLS_TOE is not set

# --- SATA/SAS: boot media only ----------------------------------------------
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_ACPI=y
CONFIG_SATA_AHCI=y
# No SATA port multipliers (consumer port expanders) and no legacy /proc/scsi.
# CONFIG_SATA_PMP is not set
# CONFIG_SCSI_PROC_FS is not set
# CONFIG_BLK_DEV_SR is not set
# CONFIG_CHR_DEV_SG is not set

# --- device-mapper: verity root, encrypted scratch --------------------------
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_UEVENT=y
# CONFIG_BLK_DEV_MD is not set
# CONFIG_DM_SNAPSHOT is not set
# CONFIG_DM_THIN_PROVISIONING is not set

# --- Filesystems ------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
# Online scrub and repair are ON.  They arrive as Kconfig defaults, which is
# precisely why they are stated here: a filesystem that can repair itself
# while mounted is a real behaviour change and should be a decision, not an
# inheritance.  Fleet practice is still drain-and-reimage on corruption; scrub
# is what tells you corruption happened before the guest notices.
CONFIG_XFS_ONLINE_SCRUB=y
CONFIG_XFS_ONLINE_REPAIR=y
# The menu that gates squashfs/erofs.  Stated explicitly: relying on its
# `default y` made it flip off in a profile that strips neighbouring options.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_HUGETLBFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_FUSE_FS=y
CONFIG_FS_POSIX_ACL=y
# EFI system partition.
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Everything below has no place on a hypervisor host and is a parser exposed
# to attacker-influenced bytes.
# CONFIG_BTRFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_QUOTA is not set
