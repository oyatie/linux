# ---------------------------------------------------------------------------
# layer-worker: the machine agent -- the worker node that actually runs
# tenant tasks.
#
# This is the most exposed layer in the fleet and the one with the most
# kernel surface, because it is the only one running other people's code.
# Everything here is either isolation enforcement or the sandbox itself.
# ---------------------------------------------------------------------------

# --- Resource enforcement ---------------------------------------------------
# The whole point of the agent: bound what a task can take.  CFS bandwidth and
# the io controllers are the enforcement mechanism, PSI is how you detect the
# machine is oversubscribed before tasks start missing deadlines.
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_CGROUP_HUGETLB=y
# net_cls and net_prio are cgroup *v1* controllers with no v2 equivalent --
# on v2 you classify and prioritise with tc filters and BPF, keyed on the
# cgroup id.  Enabling them on a v1-disabled kernel is dead code that also
# quietly contradicts the v2-only claim.
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_NET_CLS_CGROUP is not set
CONFIG_PSI=y

# BPF schedulers.  The worker is where placement policy is worth iterating on
# without a kernel release -- pinning latency-sensitive tasks off SMT
# siblings, or draining a core class.  Deliberately NOT enabled on the other
# layers: loading a scheduler is a machine-wide risk and only pays for itself
# where task placement is the product.
CONFIG_SCHED_CLASS_EXT=y

# Cache and memory-bandwidth partitioning.  Without RDT/CLOS a batch task can
# evict a latency-sensitive task's working set from L3 and there is nothing in
# cgroups that will stop it.
CONFIG_X86_CPU_RESCTRL=y

# --- Sandboxing -------------------------------------------------------------
# Untrusted tasks run under gVisor or a microVM, both of which want KVM.  This
# is KVM *only*: no VFIO, no device assignment, no SEV/TDX -- a worker node
# hands out sandboxes, it does not hand out hardware.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_KVM_SMM=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VSOCKETS=y
CONFIG_VHOST_VSOCK=y
# CONFIG_VFIO is not set
# CONFIG_KVM_AMD_SEV is not set
# CONFIG_INTEL_TDX_HOST is not set

# --- Task networking --------------------------------------------------------
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# --- L7 termination -------------------------------------------------------
# NIC TLS offload pays off only where a proxy terminates a lot of TLS and opts
# into kTLS (nginx/HAProxy/Envoy with OpenSSL kTLS enabled).  That is an
# ingress or mesh sidecar on a worker -- not the RPC between control-plane
# components, which never reaches the kernel TLS stack.
CONFIG_TLS_DEVICE=y

# Socket-level redirect: splice two sockets in the kernel instead of copying
# through userspace.  The mechanism behind sidecar-bypass acceleration.
CONFIG_BPF_STREAM_PARSER=y
CONFIG_NET_SOCK_MSG=y

# --- Local scratch ----------------------------------------------------------
# Task scratch space is encrypted because it outlives the task by however long
# it takes to reclaim, and the next task must not read it.
CONFIG_DM_CRYPT=y

# Not here: GPUs and accelerators.  A DRM stack on the most exposed layer in
# the fleet is a deliberate no; a GPU fleet gets its own profile and its own
# risk acceptance.
