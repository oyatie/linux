# ---------------------------------------------------------------------------
# layer-hypervisor: the host side of the product.  KVM, vhost, device
# assignment, confidential computing, and the v1 software overlay.  The VMMs
# on top are Cloud Hypervisor and Firecracker; everything else in this kernel
# exists to keep this layer fed.
# ---------------------------------------------------------------------------

CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y

# System Management Mode emulation: required by OVMF/SeaBIOS-based guest
# firmware, i.e. by every general-purpose guest image.

# Hyper-V enlightenments are NOT default: a Linux-only / Firecracker pool has
# no Windows guests to enlighten.  Selling Windows VMs = KVMHOST_EXTRA=opt-windows
# (which sets KVM_HYPERV=y itself, applied last).  Stated as an explicit strip
# because KVM_HYPERV is default-on: without this line every tenant gets a second
# guest->host hypercall/synthetic-MSR ABI the design rejects.
# CONFIG_KVM_HYPERV is not set

# Xen HVM shim / Xen PV guests are not part of this platform.
# CONFIG_KVM_XEN is not set
# CONFIG_KVM_SW_PROTECTED_VM is not set
# CONFIG_KVM_WERROR is not set
# CONFIG_KVM_PROVE_MMU is not set

# --- Confidential computing (host side) -------------------------------------
# AMD SEV/SEV-ES/SEV-SNP needs the PSP mailbox driver (CCP).
# Intel TDX host support.  The TDX module needs CONTIG_ALLOC, which on this
# config only comes from CMA.  CMA itself reserves nothing unless cma= is
# passed on the command line.
CONFIG_CMA=y

# --- vhost: in-kernel datapaths ---------------------------------------------
CONFIG_VHOST_MENU=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=y
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKETS=y
CONFIG_VSOCKETS_DIAG=y
# CONFIG_VHOST_SCSI is not set
# CONFIG_VHOST_CROSS_ENDIAN_LEGACY is not set

# --- Device assignment ------------------------------------------------------
# iommufd is the modern uAPI; VFIO_CONTAINER stays for control planes still
# on the type1 ioctls.
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_PCI_CORE=y
CONFIG_VFIO_DEVICE_CDEV=y
CONFIG_VFIO_CONTAINER=y
# CONFIG_IOMMUFD_VFIO_CONTAINER is not set
# mlx5 VF live migration (vfio variant driver) -- required to evacuate a host
# without disconnecting SR-IOV-attached guests.  Assumes the fleet NICs
# include mellanox (every hypervisor-class profile pins NICS=mellanox);
# building one with KVMHOST_NICS=intel alone fails here by design, since the
# driver needs MLX5_CORE.
CONFIG_MLX5_VFIO_PCI=y

CONFIG_PCI_IOV=y
CONFIG_PCI_ATS=y
CONFIG_PCI_PRI=y
CONFIG_PCI_PASID=y

# IOMMU passthrough policy lives here; the base IOMMU (DMA protection for the
# host's own devices) is in 40-platform.config, because every machine wants
# it whether or not it assigns devices to guests.
CONFIG_IOMMUFD=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# Shared virtual addressing hands a device the CPU page tables.  Off.
# CONFIG_INTEL_IOMMU_SVM is not set

# --- v1 software overlay ----------------------------------------------------
# Moved here from the shared net base: only the host that terminates tenant
# traffic runs an overlay.  This is v1 plumbing, not identity -- the DPU SKU
# (opt-dpu) deletes all of it because the card terminates the overlay and the
# host never touches a tenant packet.  Do not grow VPC semantics into OVS.
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_BONDING=y
CONFIG_OPENVSWITCH=y
CONFIG_OPENVSWITCH_VXLAN=y
CONFIG_OPENVSWITCH_GENEVE=y

# Overlay datapath offload: the generic switchdev / flowtable / conntrack-action
# datapath, plus the mlx5 eswitch + TC connection-tracking offload that
# accelerates it in the NIC.  Moved OUT of hw-nic-mellanox.config: this is
# overlay code, not driver code, and hw-nic-mellanox is selected by
# NICS=mellanox on SKUs that run no overlay at all (trusted-compute uses
# layer-containers yet still pins NICS=mellanox), where it was unused,
# tenant-reachable packet-processing surface.  Placed here so only the overlay
# hosts -- hypervisor / hypervisor-dpu / gpu-node -- get it.  opt-dpu unsets the
# flowtable/act_ct/TC-CT half again on the DPU SKU, exactly as it unsets the
# OVS/VXLAN lines above (OVERRIDES are applied last: last-fragment-wins).
#
# Dependency assumption: MLX5_ESWITCH/CLS_ACT/TC_CT need the mlx5 driver
# (MLX5_CORE_EN), which deliberately STAYS in hw-nic-mellanox.config.  Safe
# because every hypervisor-class profile pins NICS=mellanox, so hw-nic-mellanox
# is always merged alongside this layer -- the same assumption MLX5_VFIO_PCI
# above already makes.  Building a hypervisor layer with KVMHOST_NICS=intel
# alone would (by design) leave these MISSING at check-config, since MLX5_CORE_EN
# would be absent.  The generic four rest on NET_CLS_ACT / NF_CONNTRACK / NF_NAT
# / NF_TABLES from the 30-net base, which every profile gets.
CONFIG_NET_SWITCHDEV=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NET_ACT_CT=y
CONFIG_NET_TC_SKB_EXT=y
CONFIG_MLX5_ESWITCH=y
CONFIG_MLX5_CLS_ACT=y
CONFIG_MLX5_TC_CT=y

# tc-flower is the classifier ovs-vswitchd programs when hw-offload=true, and
# it was in no fragment: without it every symbol above is unreachable, because
# there is no uAPI left to install a flow with.  MLX5_CLS_ACT compiles in the
# driver's offload handler and nothing can ever call it.  The two actions below
# are what OVS actually emits for an offloaded overlay flow (lib/tc.c):
#
#   gact        -- `drop`, and `goto chain N`, which is how every ct+recirc
#                  flow is expressed.  Without it the connection-tracking
#                  offload that NET_ACT_CT / MLX5_TC_CT exist for cannot be
#                  programmed at all.
#   tunnel_key  -- set/unset of the VXLAN/GENEVE outer header.  Without it the
#                  tunnelled flows -- which is all tenant traffic on this
#                  overlay -- fall back to the software datapath, silently.
#
# mirred (output/redirect to a port) is the third action OVS needs and is
# already =y from the 30-net base; named here because this layer now leans on
# it, alongside NET_SCH_INGRESS which is the qdisc the filters attach to.
# NOT added: pedit/csum (header rewrite) and act_vlan.  This overlay forwards
# L2 inside a tunnel and rewrites nothing; add them the day OVS does L3 here.
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_TUNNEL_KEY=y

# The offload chain is only worth anything end to end, and a missing link is
# not a build failure -- it is a silent fallback to software.  So state the
# coupling Kconfig cannot see.  Vacuous on the DPU SKU, where opt-dpu removes
# OPENVSWITCH itself: an absent dataplane cannot be inert.
# ASSERT-ALL: CONFIG_OPENVSWITCH => CONFIG_NET_CLS_FLOWER CONFIG_NET_ACT_GACT CONFIG_NET_ACT_MIRRED CONFIG_NET_ACT_TUNNEL_KEY CONFIG_NET_SCH_INGRESS

# --- Per-instance bandwidth caps --------------------------------------------
# The 30-net base carries fq / fq_codel, which manage queueing LATENCY for the
# host's own traffic; neither can cap a rate.  This SKU had no classful or
# shaping qdisc at all, so a hypervisor selling VMs had no way to enforce the
# instance type's network allowance.  On a software dataplane that is host-side
# qdisc work, and it takes both directions of the tap/representor:
#
#   toward the guest  -- shapeable: a root HTB, hierarchical so an instance's
#                        guarantee and its ceiling are separable and a host
#                        aggregate can sit above them (and mlx5 can offload the
#                        HTB itself), or a flat TBF where one number is enough.
#   from the guest    -- arrives on the device's INGRESS, which cannot be
#                        shaped, only policed: matchall + police.  That pair is
#                        also exactly what OVS installs for ovs-vsctl's
#                        ingress_policing_rate, so it is on the product path
#                        twice over.
#
# IFB + mirred -- shaping the from-guest direction instead of policing it -- is
# a deliberate omission: it doubles the per-instance device count for a
# fairness gain the instance types do not currently promise.
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_POLICE=y
# ETS is the uplink's problem rather than the instance's, and belongs to the
# same gap: one NIC carries tenant traffic, NVMe-oF and the control plane, and
# with no class scheduler a tenant burst starves storage.  Strict priority +
# WRR in one qdisc, the modern replacement for PRIO+DRR.
CONFIG_NET_SCH_ETS=y
# A software dataplane with no way to cap an instance is the defect this block
# fixes.  ANY, not ALL: HTB or TBF, whichever the fleet standardises on.
# ASSERT-ANY: CONFIG_OPENVSWITCH => CONFIG_NET_SCH_HTB CONFIG_NET_SCH_TBF

# --- Host userspace is the agent + the VMM ----------------------------------
# Neither runs rootless, so unprivileged user namespaces -- the most
# productive privilege-escalation surface in the modern kernel -- protect
# nobody here.  Put this back the day the VMM jailer goes rootless.
# CONFIG_USER_NS is not set

# On-fabric default congestion control: DCTCP (base now defaults to cubic for
# the off-fabric SKUs -- workstation, guests -- that talk to the internet).
# Overriding a Kconfig choice requires unsetting the base member explicitly.
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_DCTCP=y
CONFIG_DEFAULT_TCP_CONG="dctcp"
