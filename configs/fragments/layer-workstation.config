# layer-workstation: structural reversals from the fleet stance so a general
# machine boots and is usable, while the hardened base (KSPP, lockdown, LSMs,
# Secure Boot) stays.  All last-wins over base.

# --- signed loadable modules: how you boot arbitrary hardware; only signed ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# --- swap via zram (compressed RAM); a workstation is not an SLO host --------
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y

# --- suspend-to-RAM (no hibernate: we ship no disk swap image) ---------------
CONFIG_SUSPEND=y

# --- a real console + input: reverse the fleet's serial-only / no-VT ---------
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# --- DRM + framebuffer console core so a display lights up (panels: hw-client)
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- USB core + xHCI + HID built-in so a USB keyboard works pre-userspace ----
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# --- full-disk encryption: TPM-backed LUKS is mandatory on a machine holding
#     datacenter access ----------------------------------------------------
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

# --- dev tools: engineers run local VMs (incl. testing the fleet kernels) and
#     containers.  KVM host both vendors; FUSE; TUN --------------------------
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_VHOST_NET=y
CONFIG_TUN=y
CONFIG_FUSE_FS=y

# --- client filesystems: removable media, desktop fs ------------------------
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_BTRFS_FS=m

# --- laptop ACPI that 95-no-legacy strips on servers ------------------------
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_VIDEO=m

# --- menu gates + strip-reversals the general SKU needs (base/90-strip turn
#     these off for servers; a workstation legitimately wants them) ---------
CONFIG_VIRTUALIZATION=y
CONFIG_VHOST_MENU=y
CONFIG_VHOST=y
CONFIG_HID_SUPPORT=y
CONFIG_I2C=y
CONFIG_FB_CORE=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_WIRELESS=y
CONFIG_X86_PLATFORM_DEVICES=y

# --- authenticated FDE: dm-integrity's hmac-sha256 recipe needs CRYPTO_HMAC;
#     without it the standard authenticated LUKS2 setup fails at runtime -----
CONFIG_CRYPTO_HMAC=y

# --- early framebuffer: a console BEFORE i915/amdgpu modules load (else the
#     screen is dark through initramfs) --------------------------------------
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
