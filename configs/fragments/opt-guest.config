# ---------------------------------------------------------------------------
# opt-guest: make the same image bootable *inside* a VM.
#
# Two real uses: CI (boot-test the host kernel under QEMU without bare metal)
# and nested virtualization, where a host kernel runs as an L1 guest.
#   make KVMHOST_EXTRA=opt-guest build
#
# This is the curated stand-in for upstream's `make kvm_guest.config`
# (kernel/configs/kvm_guest.config).  We do not use that target: it enables
# DRM_VIRTIO_GPU, VIRTIO_INPUT, 9P_FS/NET_9P and SCSI_VIRTIO, all of which
# 90-strip.config exists to keep out, and it says nothing about vsock,
# virtiofs or ptp_kvm, which are the parts that actually matter here.
# ---------------------------------------------------------------------------
# The virtio block/net/console drivers live in 15-vm-boot.config (always on).
# What is left here changes bare-metal behaviour, so it stays opt-in.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PTP_1588_CLOCK_KVM=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_IOMMU=y
