# AMD-only fleet.  Mirror of cpu-intel.config -- see it for the rationale and
# the qualification cost.
#
#   make PROFILE=hypervisor CPU=amd build
# CONFIG_KVM_INTEL is not set
# CONFIG_KVM_INTEL_TDX is not set
# CONFIG_INTEL_TDX_HOST is not set
# CONFIG_CPU_SUP_INTEL is not set
# CONFIG_INTEL_IOMMU is not set
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set
# CONFIG_EDAC_SKX is not set
# CONFIG_EDAC_I10NM is not set
# CONFIG_EDAC_IGEN6 is not set
# CONFIG_X86_INTEL_PSTATE is not set
# CONFIG_INTEL_IDLE is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_INTEL_RAPL is not set
# CONFIG_SENSORS_CORETEMP is not set
# CONFIG_HW_RANDOM_INTEL is not set
# Posted MSI is a VT-d feature.
# CONFIG_X86_POSTED_MSI is not set

# Intel-specific mitigations, dropped for the same reason (see
# cpu-intel.config): L1TF, MDS, TAA, RFDS, GDS, BHI and the IBRS entry
# sequence are all Intel erratum responses.
#
# NOTE this is the one place where getting the CPU fragment wrong is
# dangerous rather than merely wasteful: building CPU=amd and then deploying
# the image on Intel silicon produces a kernel with L1TF and MDS mitigations
# *compiled out*.  Tie this to the SKU in the build pipeline.
# CONFIG_MITIGATION_L1TF is not set
# CONFIG_MITIGATION_MDS is not set
# CONFIG_MITIGATION_TAA is not set
# CONFIG_MITIGATION_MMIO_STALE_DATA is not set
# CONFIG_MITIGATION_RFDS is not set
# CONFIG_MITIGATION_GDS is not set
# CONFIG_MITIGATION_SPECTRE_BHI is not set
# CONFIG_MITIGATION_IBRS_ENTRY is not set
