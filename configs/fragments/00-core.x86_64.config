# x86_64 side of 00-core: silicon-specific plumbing the shared fragment must
# not request, because these symbols do not exist on other architectures.
CONFIG_X86_64=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_MCE_THRESHOLD=y
CONFIG_MICROCODE=y
CONFIG_MICROCODE_LATE_LOADING=y
# Cache/memory-bandwidth partitioning (RDT/CLOS).  arm64's equivalent is MPAM,
# which is not yet a per-fleet default -- see 00-core.arm64.config.
CONFIG_X86_CPU_RESCTRL=y
CONFIG_HPET_TIMER=y
CONFIG_X86_POSTED_MSI=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_PHYSICAL_ALIGN=0x200000
# MAXSMP pins NR_CPUS to 8192 with offstack cpumasks; x86-only symbol.
CONFIG_MAXSMP=y
CONFIG_RTC_DRV_CMOS=y
# EARLY_PRINTK is x86-only; arm64 uses earlycon (a parameter, not a symbol).
CONFIG_EARLY_PRINTK=y
# The compressed-kernel choice exists only on x86; arm64 boots raw Image.
CONFIG_KERNEL_ZSTD=y
# HVO: only x86/loongarch/riscv opt in upstream (grep ARCH_WANT_OPTIMIZE_
# HUGETLB_VMEMMAP) -- the struct-page RAM recovery does NOT exist on arm64,
# which changes the memory math for 1G-page fleets there.
CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP=y
CONFIG_HUGETLB_PAGE_OPTIMIZE_VMEMMAP_DEFAULT_ON=y
