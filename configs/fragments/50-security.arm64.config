# arm64 security: the same posture, different silicon mechanisms.
#
# Speculation:
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
# (rodata=full is unconditional on modern kernels; the old
# RODATA_FULL_DEFAULT_ENABLED symbol is gone.)
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_E0PD=y
# Control flow / memory tagging -- the CET/IBT counterparts.  All of these
# no-op gracefully on cores without the feature:
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
# BTI for the *kernel* is clang-only upstream (`depends on !CC_IS_GCC`, gcc
# bug 106671); this is a GCC toolchain, so userspace BTI is what we get.
# Revisit if the builder moves to clang/LLVM=1.
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_MTE=y
# Crypto extensions for dm-crypt/verity (AES-NI counterpart).
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

# Max out mmap ASLR entropy (arm64 4K/48-bit ceiling is 33).
CONFIG_ARCH_MMAP_RND_BITS=33
