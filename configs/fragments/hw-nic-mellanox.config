# NVIDIA/Mellanox ConnectX (mlx5).  ~1.4 MiB.
# Includes the eswitch/TC offload path.  The VFIO variant driver for VF live
# migration lives in layer-hypervisor.config -- it needs VFIO_PCI_CORE, which
# only that layer has.
# The eswitch/TC-offload dependency chain lives here with the driver that
# needs it, not in the shared net base: switchdev and the flowtable are
# meaningless without a NIC that offloads them.
CONFIG_NET_SWITCHDEV=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NET_ACT_CT=y
CONFIG_NET_TC_SKB_EXT=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_MLX5_ESWITCH=y
CONFIG_MLX5_CLS_ACT=y
CONFIG_MLX5_TC_CT=y
