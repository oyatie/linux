# NVIDIA/Mellanox ConnectX (mlx5) driver.
# Selected by NICS=mellanox, so this fragment lands on every SKU that carries
# the card -- including ones that run NO software overlay (trusted-compute pins
# NICS=mellanox but uses layer-containers and never terminates tenant traffic).
# Therefore this fragment is the DRIVER ONLY.
#
# The overlay datapath + mlx5 eswitch/TC-CT offload that used to live here moved
# to layer-hypervisor.config: it is overlay code, not driver code, and only the
# hypervisor layer runs the v1 software overlay.  Leaving switchdev/flowtable/
# act_ct + MLX5_ESWITCH/CLS_ACT/TC_CT here gave overlay-less mellanox SKUs
# unused, tenant-reachable packet-processing surface.  The mlx5-specific offload
# symbols moved WITH the generic ones because every hypervisor-class profile
# pins NICS=mellanox, so this driver (MLX5_CORE_EN, their dependency) is always
# merged alongside layer-hypervisor.  See layer-hypervisor.config.
#
# The VFIO variant driver for VF live migration (MLX5_VFIO_PCI) also lives in
# layer-hypervisor.config -- it needs VFIO_PCI_CORE, which only that layer has.
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# kTLS hardware offload: mlx5 terminates TLS record crypto in the NIC, so the
# host CPU never touches the symmetric cipher.  Core kTLS (CONFIG_TLS) comes
# from 20-storage; this enables the device-offload path it rides on.
CONFIG_TLS_DEVICE=y
