# ---------------------------------------------------------------------------
# 30-net: host networking stack, tenant dataplane, NIC drivers.
#
# The overlay is built out of tap/macvtap + bridge/OVS + VXLAN/GENEVE and
# steered with eBPF/tc/XDP.  Legacy iptables is deliberately absent: nftables
# is the only packet-filter uAPI on this host.
# ---------------------------------------------------------------------------

CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Congestion control / queueing: BBR + fq is the standard datacenter pairing.
CONFIG_TCP_CONG_ADVANCED=y
# Two different problems, so two algorithms:
#
#   east-west (in-cell / cross-cell RPC) is DCTCP.  Inside the DC the
#   switches are shallow-buffered and the pathology is incast from
#   partition/aggregate fan-in; DCTCP's multi-bit ECN feedback is what
#   keeps queueing delay near zero under it.  BBR is solving the wrong
#   problem here -- it estimates bottleneck bandwidth on a path whose
#   bottleneck is a switch buffer being hit by 40 simultaneous responses.
#
#   north-south (public internet) is BBR, on the fallback H2 path.  Most
#   north-south traffic is QUIC over UDP and never touches this at all.
#
# PREREQUISITE -- DCTCP is worse than cubic without it: the fabric must
# mark ECN (AQM/WRED on the switches) and net.ipv4.tcp_ecn=1 must be set.
# A fleet that has not verified end-to-end marking should override with
# net.ipv4.tcp_congestion_control=bbr.  See docs/TUNING.md.
CONFIG_TCP_CONG_DCTCP=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
# No legacy/niche congestion control beyond the three we actually use.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
CONFIG_DEFAULT_DCTCP=y
CONFIG_DEFAULT_TCP_CONG="dctcp"
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_MIRRED=y

# --- Generic plumbing -------------------------------------------------------
# What EVERY kernel here can justify: tap devices for a VMM or a VPN, veth +
# bridge for containers, VLANs, a dummy device.  The tenant *overlay* -- OVS,
# VXLAN/GENEVE encap, macvtap/ipvlan -- is a hypervisor-host concern and lives
# in layer-hypervisor.config; it is v1 plumbing there, not identity, and the
# DPU SKU deletes it entirely.
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_DUMMY=y

# --- No kernel IPsec --------------------------------------------------------
# East-west security is SPIFFE mTLS terminated by the RPC stack in userspace;
# the kernel never sees a plaintext record boundary, so XFRM/ESP would be a
# second encryption layer that nobody audits and everybody pays for.  A fleet
# that genuinely needs kernel IPsec (a site-to-site gateway) adds a fragment.

# --- Filtering: nftables only -----------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_NETFILTER_XTABLES is not set

# --- eBPF -------------------------------------------------------------------
# JIT always on (no interpreter to attack), unprivileged BPF off.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
# CONFIG_BPF_UNPRIV_DEFAULT_OFF is enforced below
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- Time sync --------------------------------------------------------------
CONFIG_PTP_1588_CLOCK=y
CONFIG_PPS=y
CONFIG_NETWORK_PHY_TIMESTAMPING=y

# --- NIC drivers: datacenter parts only -------------------------------------
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y
CONFIG_PHYLIB=y

# NIC drivers are NOT here.  They are per-fleet hardware, selected by
# KVMHOST_NICS (see scripts/build.sh and hw-nic-*.config).  Building all of
# them in costs ~3.5 MiB of always-resident driver text for hardware a given
# host does not have -- which is the same argument this whole config makes
# about everything else.
