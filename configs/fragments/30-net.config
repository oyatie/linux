# ---------------------------------------------------------------------------
# 30-net: host networking stack, tenant dataplane, NIC drivers.
#
# The overlay is built out of tap/macvtap + bridge/OVS + VXLAN/GENEVE and
# steered with eBPF/tc/XDP.  Legacy iptables is deliberately absent: nftables
# is the only packet-filter uAPI on this host.
# ---------------------------------------------------------------------------

CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_UNIX_DIAG=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPIP=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Congestion control / queueing: BBR + fq is the standard datacenter pairing.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_MQPRIO=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_CT=y
CONFIG_NET_TC_SKB_EXT=y

# --- Tenant plumbing --------------------------------------------------------
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VLAN_8021Q=y
CONFIG_VXLAN=y
CONFIG_GENEVE=y
CONFIG_BONDING=y
CONFIG_DUMMY=y
CONFIG_OPENVSWITCH=y
CONFIG_OPENVSWITCH_VXLAN=y
CONFIG_OPENVSWITCH_GENEVE=y

# --- IPsec for east-west encryption -----------------------------------------
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET6_ESP=y
CONFIG_INET_ESP_OFFLOAD=y

# --- Filtering: nftables only -----------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_NETFILTER_XTABLES is not set

# --- eBPF -------------------------------------------------------------------
# JIT always on (no interpreter to attack), unprivileged BPF off.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_XDP_SOCKETS=y
CONFIG_XDP_SOCKETS_DIAG=y
# CONFIG_BPF_UNPRIV_DEFAULT_OFF is enforced below
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- Time sync --------------------------------------------------------------
CONFIG_PTP_1588_CLOCK=y
CONFIG_PPS=y
CONFIG_NETWORK_PHY_TIMESTAMPING=y

# --- NIC drivers: datacenter parts only -------------------------------------
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y
CONFIG_PHYLIB=y

# NIC drivers are NOT here.  They are per-fleet hardware, selected by
# KVMHOST_NICS (see scripts/build.sh and hw-nic-*.config).  Building all of
# them in costs ~3.5 MiB of always-resident driver text for hardware a given
# host does not have -- which is the same argument this whole config makes
# about everything else.
CONFIG_NET_SWITCHDEV=y
CONFIG_NF_FLOW_TABLE=y
