# ---------------------------------------------------------------------------
# strip-host: remove everything a guest has no business carrying.
#
# Applied last by the microvm profile, so it overrides the shared base.  Each
# block below is a thing a *host* must do and a guest must not.
# ---------------------------------------------------------------------------

# Physical hardware: the guest sees virtio and nothing else.
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_SATA_AHCI is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_MULTIPATH is not set

# Cannot be stripped, recorded so nobody re-tries it:
#   MICROCODE  -- def_bool y on any Intel/AMD CPU since 6.6; not optional.
#   CPU_FREQ / CPU_IDLE / THERMAL / *_PSTATE -- selected by ACPI_PROCESSOR,
#     which the guest needs for its virtual CPUs.  Inert under a hypervisor
#     that does not expose P-states, but present.
#
# RAS, out-of-band management, power, telemetry: the host owns the machine.
# CONFIG_RAS is not set
# CONFIG_RAS_CEC is not set
# CONFIG_EDAC is not set
# CONFIG_ACPI_APEI is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_TCG_TPM is not set
# CONFIG_HWMON is not set
# CONFIG_POWERCAP is not set
# CONFIG_INTEL_RAPL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_PCIEAER is not set
# CONFIG_PCIE_DPC is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_X86_CPU_RESCTRL is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_INTEL_IOMMU is not set
# CONFIG_AMD_IOMMU is not set
# CONFIG_IRQ_REMAP is not set

# Fleet-scale CPU/memory topology: a guest gets what it was sold.
#
# CAVEAT, and it is a real one: this is correct only for guests that fit in
# one NUMA node.  A large instance spanning two host sockets is sold *with*
# vNUMA, and a guest kernel without CONFIG_NUMA cannot place its own memory --
# it will scatter allocations across both nodes and lose the locality the
# customer is paying for.  A large-instance guest profile must put NUMA (and a
# higher NR_CPUS) back.
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=64
# CONFIG_NUMA is not set
# CONFIG_NO_HZ_FULL is not set
# CONFIG_SCHED_CORE is not set

# Host filesystems.  A guest rootfs is ext4 or a verity-backed squashfs.
# CONFIG_XFS_FS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_DM_CRYPT is not set

# Host networking: no tenant dataplane inside a single-tenant guest.
# CONFIG_OPENVSWITCH is not set
# CONFIG_BRIDGE is not set
# CONFIG_VXLAN is not set
# CONFIG_GENEVE is not set
# CONFIG_MACVLAN is not set
# CONFIG_MACVTAP is not set
# CONFIG_IPVLAN is not set
# CONFIG_BONDING is not set
# CONFIG_IP_VS is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_NET_SCHED is not set

# Host security policy: the guest runs one workload under its own rules.
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="landlock,lockdown,yama,bpf"

# Host observability: tracing belongs to whoever debugs the machine.
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_STACK_TRACER is not set
# CONFIG_SCHED_TRACER is not set
# CONFIG_HIST_TRIGGERS is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_PSTORE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_PROC_VMCORE is not set

# Live update: a guest is replaced, not upgraded in place.
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_KEXEC_HANDOVER_DEBUGFS is not set
# CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT is not set
# CONFIG_LIVEUPDATE is not set
# CONFIG_LIVEUPDATE_MEMFD is not set
# CONFIG_KEXEC_FILE is not set

# ---------------------------------------------------------------------------
# Orphans: children of the subsystems stripped above.  Listed explicitly
# because the base fragments ask for them, and a request the kernel silently
# drops is exactly what check-config.sh exists to catch.
# ---------------------------------------------------------------------------

# ...of RAS/APEI/EDAC:
# CONFIG_ACPI_APEI_GHES is not set
# CONFIG_ACPI_APEI_MEMORY_FAILURE is not set
# CONFIG_ACPI_APEI_PCIEAER is not set
# CONFIG_EDAC_GHES is not set
# CONFIG_EDAC_SKX is not set
# CONFIG_EDAC_I10NM is not set
# CONFIG_EDAC_IGEN6 is not set
# CONFIG_EDAC_AMD64 is not set

# ...of IPMI / watchdog / sensors / TPM:
# CONFIG_ACPI_IPMI is not set
# CONFIG_IPMI_DEVICE_INTERFACE is not set
# CONFIG_IPMI_SI is not set
# CONFIG_IPMI_WATCHDOG is not set
# CONFIG_ITCO_WDT is not set
# CONFIG_WATCHDOG_SYSFS is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
# CONFIG_SENSORS_CORETEMP is not set
# CONFIG_SENSORS_K10TEMP is not set
# CONFIG_NVME_HWMON is not set
# CONFIG_TCG_TIS is not set
# CONFIG_TCG_CRB is not set
# CONFIG_MICROCODE_LATE_LOADING is not set

# ...of the storage controllers:
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA_ACPI is not set
# CONFIG_XFS_ONLINE_SCRUB is not set
# CONFIG_XFS_ONLINE_REPAIR is not set
# CONFIG_EROFS_FS_ZIP is not set
# CONFIG_EROFS_FS_ZIP_ZSTD is not set

# ...of PCI hotplug / IOMMU / NUMA:
# CONFIG_HOTPLUG_PCI_PCIE is not set
# CONFIG_HOTPLUG_PCI_ACPI is not set
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set
# CONFIG_IOMMU_API is not set
# CONFIG_IOMMU_DMA is not set
# CONFIG_X86_POSTED_MSI is not set
# CONFIG_ACPI_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_RCU_NOCB_CPU is not set
# CONFIG_MMU_NOTIFIER is not set

# ...of power/thermal:
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_X86_ACPI_CPUFREQ is not set
# CONFIG_CPU_IDLE_GOV_MENU is not set
# CONFIG_CPU_IDLE_GOV_TEO is not set

# ...of the host dataplane:
# CONFIG_BRIDGE_VLAN_FILTERING is not set
# CONFIG_OPENVSWITCH_VXLAN is not set
# CONFIG_OPENVSWITCH_GENEVE is not set
# CONFIG_INET_ESP_OFFLOAD is not set
# CONFIG_NET_SCH_FQ is not set
# CONFIG_NET_SCH_FQ_CODEL is not set
# CONFIG_NET_SCH_MQPRIO is not set
# CONFIG_NET_SCH_INGRESS is not set
# CONFIG_NET_CLS_BPF is not set
# CONFIG_NET_CLS_ACT is not set
# CONFIG_NET_ACT_BPF is not set
# CONFIG_NET_ACT_MIRRED is not set
# CONFIG_NET_ACT_CT is not set
# CONFIG_NET_TC_SKB_EXT is not set
# CONFIG_NET_SWITCHDEV is not set

# ...of SELinux:
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
# CONFIG_SECURITY_SELINUX_AVC_STATS is not set

# ...of tracing / crash handling:
# CONFIG_DYNAMIC_FTRACE is not set
# CONFIG_UPROBES is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_RAM is not set
# CONFIG_EFI_VARS_PSTORE is not set
# CONFIG_CRASH_HOTPLUG is not set
