# hw-client: broad modern client-hardware drivers for the workstation SKU, as
# SIGNED modules so they load on demand for whatever is present.  v0 -- the
# common Intel/AMD laptop + desktop.  Broadening (more WiFi, Thunderbolt,
# MMC/SD, nouveau, docks) is the engineer-distro work.

# --- graphics: the two GPUs an engineer machine actually has ----------------
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m

# --- WiFi (Intel first -- the common laptop part) ---------------------------
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

# --- wired: laptop / desktop / USB-dock Ethernet ----------------------------
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_IGC=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m

# --- USB storage + audio (calls) --------------------------------------------
CONFIG_USB_STORAGE=m
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

# --- SATA (older / desktop disks) -------------------------------------------
CONFIG_ATA=m
CONFIG_SATA_AHCI=m

# --- i2c-HID trackpads + thermal --------------------------------------------
CONFIG_I2C_HID_ACPI=m
CONFIG_THERMAL=y
