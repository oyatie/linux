# ---------------------------------------------------------------------------
# 55-kspp: Kernel Self Protection Project settings, plus the Talos-style
# position that the kernel itself must not offer a way to run a program.
#
# The machine has no shell, no SSH and no package manager, so the remaining
# ways to get code running are the kernel's own: usermode helpers, sysrq,
# binfmt_misc, TTY injection.  Those close here.
# ---------------------------------------------------------------------------

# The kernel calls out to userspace for core dumps, hotplug, and (with
# modules) module loading.  An empty helper path disables the mechanism
# outright -- there is no path a compromised kernel context can point at.
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""

# binfmt_misc lets userspace register an interpreter for arbitrary magic
# bytes.  Nothing here needs it and it is a persistence primitive.
# CONFIG_BINFMT_MISC is not set

# sysrq is a physical/serial console backdoor: it can kill tasks, remount, and
# dump memory.  These machines are managed over an API, not a console.
# CONFIG_MAGIC_SYSRQ is not set

# TIOCSTI injects characters into another process's TTY.
# CONFIG_LEGACY_TIOCSTI is not set

# Kernel pointers and log contents are attacker-useful.
CONFIG_SECURITY_DMESG_RESTRICT=y

# Obsolete syscall multiplexers.
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_USELIB is not set

# Free-time poisoning as well as alloc-time.  This one has a real cost
# (single-digit % on allocation-heavy paths); it is on because a control-plane
# node is not a datapath and use-after-free is the bug class that matters.
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Zero call-used registers on function return: cuts the ROP/stack-spray
# gadget surface.  gcc >= 11.
CONFIG_ZERO_CALL_USED_REGS=y

# List corruption detection and friends: cheap, and they catch the
# exploitation step rather than the bug.  (REFCOUNT_FULL and DEBUG_CREDENTIALS
# are not here because upstream made both unconditional and deleted them.)
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_SCHED_STACK_END_CHECK=y
