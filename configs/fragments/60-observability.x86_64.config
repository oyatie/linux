# x86_64 observability: ORC unwinder and the vendor uncore/power PMUs.
CONFIG_UNWINDER_ORC=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_PERF_EVENTS_AMD_UNCORE=y
CONFIG_PERF_EVENTS_AMD_POWER=y
# Keep the crash kernel loaded across CPU/memory hotplug without a userspace
# reload; x86-only wiring at our floor.
CONFIG_CRASH_HOTPLUG=y
