# ---------------------------------------------------------------------------
# opt-modules: re-enable loadable modules, signature-enforced.
#
# The default image is monolithic.  Use this only if you genuinely need
# out-of-tree drivers (a vendor NIC, a fleet-specific accelerator).  Note that
# lockdown in integrity mode already refuses unsigned modules; this makes the
# kernel refuse them even with lockdown off.
# ---------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
