# ---------------------------------------------------------------------------
# layer-containers: the container stack, wherever it runs.
#
# Two consumers, deliberately the same fragment:
#   ch-guest-k8s     -- containers inside a Cloud Hypervisor guest (a sold
#                       kube node), PLATFORM=vm.
#   trusted-compute  -- first-party services on metal, PLATFORM=metal.
#
# What is NOT here is the old worker-node identity: no gVisor-KVM sandbox
# stack (tenant isolation is the VM boundary, one layer down), no NIC TLS
# offload, no sockmap acceleration, no BPF scheduler.  Those were a
# run-tenant-code-on-metal design this platform does not ship.
# ---------------------------------------------------------------------------

# --- Resource enforcement ---------------------------------------------------
# cpu.max / memory.max / io.cost are the enforcement mechanism; PSI is how the
# agent sees oversubscription before deadlines are missed.
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y
CONFIG_BLK_CGROUP_IOLATENCY=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_PSI=y
# net_cls/net_prio are cgroup v1 controllers; on v2, classify with tc + BPF
# keyed on the cgroup id.
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_NET_CLS_CGROUP is not set

# --- Service networking -----------------------------------------------------
# kube-proxy in IPVS mode, or any L4 VIP scheme.  iptables mode needs nothing
# extra: modern userspace is iptables-nft over the nf_tables API already here.
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# --- Local scratch ----------------------------------------------------------
# Container scratch outlives the container by however long reclaim takes, and
# the next tenant must not read it.
CONFIG_DM_CRYPT=y
