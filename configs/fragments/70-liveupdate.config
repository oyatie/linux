# ---------------------------------------------------------------------------
# 70-liveupdate: kexec-with-handover for HOST SKUs on the destination track.
#
# Not in the shared base: guests are replaced, not handed over, and the v1
# LTS track predates LUO entirely (build.sh gates this fragment on LUO_FLOOR
# and only for profiles that declare LIVEUPDATE=yes).
#
# Three tiers, and the fleet uses all of them:
#
#   1. Live patch a function       -- seconds, no disruption.  opt-livepatch.
#                                     This is the v1 story on VFIO hosts.
#   2. Kexec with handover (KHO)   -- ~1s of blackout, memfd-backed guest
#                                     memory survives.  Destination track.
#   3. Drain and reboot (kexec_file_load) -- the v1 default, always works.
#
# Tier 2 is what makes a fleet-wide CVE response tolerable: without it,
# patching the host kernel means migrating or killing every workload on every
# machine, which is a multi-week campaign rather than an afternoon.
#
# kexec_file_load only -- the old kexec_load syscall takes an unverified image
# from userspace and lockdown refuses it (see 60-observability.config).
# ---------------------------------------------------------------------------
CONFIG_KEXEC_HANDOVER=y
CONFIG_KEXEC_HANDOVER_DEBUGFS=y
# Arm KHO at boot rather than relying on kho=on being in every machine's
# command line.
CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT=y

# Live Update Orchestrator: hands memfd-backed memory (where a VMM keeps guest
# RAM) and supported devices to the next kernel across a kexec, so workloads
# survive a kernel upgrade.  This is the feature that sets the platform's
# minimum kernel version -- see docs/MSV.md.
CONFIG_LIVEUPDATE=y
CONFIG_LIVEUPDATE_MEMFD=y
