# ---------------------------------------------------------------------------
# layer-scheduler: the cell scheduler.
#
# Shape of the workload: one enormous, long-lived process holding the whole
# cell's state in memory, running a CPU-bound placement loop, fanning out RPCs
# to every machine.  No local durability, no guests, no containers to isolate.
#
# The kernel's job here is to stay out of the way of a multi-hundred-GB heap
# and a lot of threads.
# ---------------------------------------------------------------------------

# A heap that size lives or dies on TLB reach.  THP stays madvise-only (set in
# 00-core) so the allocator opts in deliberately rather than eating compaction
# stalls in the placement loop; hugetlb is available for the arenas that want
# a guaranteed 1G mapping.
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# One process across every NUMA node: page placement is the dominant memory
# effect.  Balancing is compiled in and left off at runtime (see TUNING.md) --
# the process knows its own topology better than the kernel's heuristic.
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y

# Profiling this loop in production is routine, not exceptional.
CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y

# High RPC fan-out: many thousands of sockets, epoll-driven.
CONFIG_EPOLL=y
CONFIG_IO_URING=y

# Not here: KVM/vhost/VFIO (no guests), IP_VS (does not front traffic),
# dm-crypt/verity for data (no local state worth encrypting), container
# resource controllers beyond what 00-core already provides.
