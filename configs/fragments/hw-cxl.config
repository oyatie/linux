# CXL: Compute Express Link memory -- pooling / expansion / hotplug.  A
# workload-host feature (not every metal image: a reclaim kernel doesn't want
# it), so it rides in the host profiles' OVERRIDES, not platform-metal.  PMEM
# mode omitted on purpose (needs LIBNVDIMM; Optane is EOL) -- this is volatile
# CXL.mem as NUMA capacity + devdax.  ZONE_DEVICE + memory hotplug support it.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_CXL_BUS=y
CONFIG_CXL_PCI=y
CONFIG_CXL_ACPI=y
CONFIG_CXL_MEM=y
CONFIG_CXL_REGION=y
