# Per-version deltas for the 7.2 (destination) track.
# BOOTPARAM_SOFTLOCKUP_PANIC became an int in 7.x: 0 warns, N panics.
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
# 7.2 rename of RANDOM_KMALLOC_CACHES.
CONFIG_KMALLOC_PARTITION_CACHES=y
# The randomization knob of the partitioned caches (the actual hardening).
CONFIG_KMALLOC_PARTITION_RANDOM=y
