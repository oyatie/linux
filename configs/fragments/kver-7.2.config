# Per-version overrides for the 7.2 mainline track.
# Applied automatically when KERNEL_VERSION starts with 7.2.
#
# 7.2: BOOTPARAM_SOFTLOCKUP_PANIC became an int (0 = warn, N = panic after N).
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1

# Live Update Orchestrator: hands selected devices and memfd-backed memory to
# the next kernel across a kexec, so guests and tenant tasks survive a kernel
# upgrade.  Does not exist on 6.18 -- kernel/liveupdate/ was added in 7.x.
CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT=y
CONFIG_LIVEUPDATE=y
CONFIG_LIVEUPDATE_MEMFD=y
