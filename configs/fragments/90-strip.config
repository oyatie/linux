# ---------------------------------------------------------------------------
# 90-strip: subsystems that must never appear, stated explicitly.
#
# The allnoconfig baseline already leaves these off.  Listing them anyway is
# the point: this file is the reviewable statement of what a hypervisor host
# is not, and it fails loudly (see scripts/check-config.sh) if some future
# `select` drags one of them back in.
# ---------------------------------------------------------------------------

# Graphics: these hosts have no display.  DRM is one of the largest and most
# CVE-dense subsystems in the tree.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FB_CORE is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_VGA_ARB is not set
# CONFIG_AGP is not set
# CONFIG_SOUND is not set

# Peripheral buses: no one plugs anything into a machine in a cold aisle, and
# each of these is a DMA-capable or parser-heavy path.
# CONFIG_USB_SUPPORT is not set
# CONFIG_THUNDERBOLT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_PCCARD is not set
# CONFIG_MMC is not set
# CONFIG_MEMSTICK is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PARPORT is not set
# CONFIG_SERIO is not set
#
# Two things we cannot strip, recorded here so nobody re-tries it:
#   I2C  -- selected by the Intel NIC drivers (SFP+ module EEPROM access).
#   PNP  -- selected by ACPI itself.

# MPTCP: multipath TCP is for clients that roam between links.  A datacenter
# host has bonded NICs and ECMP; the multipath problem is solved a layer down.
# CONFIG_MPTCP is not set

# Radio and non-datacenter networking.
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_CAN is not set
# CONFIG_ATM is not set
# CONFIG_HAMRADIO is not set
# CONFIG_NFC is not set

# Media / HID / misc desktop.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_STAGING is not set

# Legacy x86 and platform cruft.
# CONFIG_X86_16BIT is not set
# CONFIG_X86_ESPFIX64 is not set
# CONFIG_ISA_BUS is not set
# CONFIG_APM is not set
# CONFIG_X86_PLATFORM_DEVICES is not set
