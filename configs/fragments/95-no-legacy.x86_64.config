# x86 vendor gate: only Intel and AMD identification/quirk code.
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y

# Port-I/O delay method.  95-no-legacy stripped the 0x80 variant but the
# Kconfig choice simply fell through to 0xED -- still a legacy outb to a dead
# port on every inb/outb_p.  A modern server with no ISA/LPC timing
# dependency wants none at all.
CONFIG_IO_DELAY_NONE=y
# CONFIG_IO_DELAY_0X80 is not set
# CONFIG_IO_DELAY_0XED is not set
# CONFIG_IO_DELAY_UDELAY is not set
