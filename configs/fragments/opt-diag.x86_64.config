# x86 RAS injection: fire the exact GHES/MCE driver paths a physical fault
# would, via debugfs -- no hardware needed.
# mce-inject feeds structural machine-check data into the RAS subsystem.
CONFIG_X86_MCE_INJECT=y
# EINJ: ACPI platform error injection (needs an EINJ table from the platform).
CONFIG_ACPI_APEI_EINJ=y
CONFIG_ACPI_APEI_ERST_DEBUG=y
