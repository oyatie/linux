# ---------------------------------------------------------------------------
# strip-stateless: for a node with no local state and one trust domain.
#
# The scheduler holds the cluster's state in memory and rebuilds it from the
# control plane on start.  It writes nothing it cannot lose, runs one process,
# and hosts no tenant.  That invalidates a surprising amount of the base.
# ---------------------------------------------------------------------------

# No local data worth a filesystem beyond the read-only root and tmpfs.
# XFS is ~2MB of the image, and online repair is a whole self-modifying
# filesystem subsystem, for data this machine does not have.
# CONFIG_XFS_FS is not set
# CONFIG_XFS_ONLINE_SCRUB is not set
# CONFIG_XFS_ONLINE_REPAIR is not set
# CONFIG_DM_CRYPT is not set
# CONFIG_BLK_SED_OPAL is not set
# CONFIG_FUSE_FS is not set

# Remote block storage: a node that rebuilds its state from RPC does not want
# its boot path depending on the network.
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_MULTIPATH is not set

# userfaultfd exists here for post-copy live migration and CRIU, neither of
# which happens on this layer.  It is also a well-worn heap-grooming primitive
# in kernel exploits, so removing it is a security win and not just a size one.
# CONFIG_USERFAULTFD is not set

# One trust domain on the machine: nothing to isolate from anything.
# Core scheduling exists to keep SMT siblings within a tenant boundary, and
# RDT exists to stop a noisy neighbour -- there is no neighbour.
# CONFIG_SCHED_CORE is not set
# CONFIG_X86_CPU_RESCTRL is not set

# No guests, no containers with their own hugetlb budgets.
# CONFIG_CGROUP_MISC is not set
# CONFIG_CGROUP_HUGETLB is not set

# Unprivileged user namespaces are the single most productive privilege-
# escalation surface in the modern kernel -- a large fraction of container
# escapes start by creating one to reach an otherwise unreachable subsystem.
# This node runs one trusted process and no tenant code, so it pays that cost
# for nothing.
#
# CAVEAT: if the scheduler itself runs inside a rootless container, or its
# runtime insists on user namespaces, put this back.  Privileged (non-userns)
# containers are the norm for control-plane components, which is why this is
# defensible here and NOT on the worker.
# CONFIG_USER_NS is not set
