# x86_64 security: the speculation-mitigation set and x86 CFI/shadow stack.
# Every mitigation compiled in; per-fleet relaxation happens on the command
# line, never in the image (see docs/TUNING.md).
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_SSB=y
# Control-flow integrity: Intel IBT in the kernel, user shadow stacks (CET).
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_CRYPTO_AES_NI_INTEL=y
# AES-NI accelerates the AES rounds; GCM's authentication half is a carryless
# multiply (GHASH), and WITHOUT this it falls back to a software table even
# with AES-NI on.  AES-GCM is the AEAD behind TLS 1.3, kTLS, IPsec ESP and
# NVMe-oF TLS, so on a host that terminates any of those this is the single
# highest-value crypto symbol.  arm64 already had its counterpart
# (GHASH_ARM64_CE); this closes the x86 asymmetry.
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
# (SHA1/256/512 hardware accel is NOT here: 6.18+ moved it into lib/crypto,
# pulled in automatically by CRYPTO_LIB_SHA*_ARCH.  CRC32c/T10DIF likewise
# via CRC*_ARCH.  Verified present in the resolved config.)

# 50-security turns X86_VSYSCALL_EMULATION off, but the legacy vsyscall page
# is a SEPARATE choice that defaulted to XONLY -- i.e. still mapped
# execute-only.  Nothing built this decade uses the vsyscall page; NONE
# unmaps it entirely, removing a fixed-address executable region.
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
