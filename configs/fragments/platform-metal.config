# ---------------------------------------------------------------------------
# platform-metal: what owning the machine obliges, beyond drivers.
#
# The counterpart of platform-vm.config.  Metal is the default platform, so
# until now it had no fragment -- this exists for policies meaningful ONLY at
# the host trust boundary.
#
# Deliberately NOT applied to guests: kexec signing protects the host trust
# boundary, and inside a guest root already owns the kernel choice -- they
# can simply reboot into anything.  ch-guest keeps plain unsigned kdump, and
# Kconfig agrees mechanically: the verification stack
# (SYSTEM_DATA_VERIFICATION) is promptless, reachable only via
# MODULE_SIG-style selectors a modules-less guest rightly lacks.
# ---------------------------------------------------------------------------

# Signature verification on the kexec path.  Verified against the source
# rather than folklore: the lockdown hook for kexec_file_load lives INSIDE the
# CONFIG_KEXEC_SIG block (kernel/kexec_file.c, kimage_validate_signature), so
# without this symbol lockdown never sees the syscall and any root can load
# any kernel.  With it plus our forced-integrity lockdown: unsigned images are
# refused (EPERM before parsing), signed images load.  Production must
# therefore sign kernels and enroll the CA; the smoke test asserts the EPERM.
# (KEXEC_SIG_FORCE stays off: lockdown already provides the refusal, and
# FORCE would break signed-kexec on machines booted with lockdown=none.)
CONFIG_KEXEC_SIG=y
# The verifiers check PE signatures (the same format Secure Boot uses).
CONFIG_SIGNED_PE_FILE_VERIFICATION=y

# The dm-verity root hash must carry a signature the KERNEL verifies against
# the trusted keyring -- otherwise the verity chain ends at userspace's word.
# This was a real gap (DESIGN.md promised a signed verity root; nothing
# verified it), and it also happens to be the principled selector of
# SYSTEM_DATA_VERIFICATION that modules-less metal (trusted-compute) needs
# for KEXEC_SIG to be enableable at all.
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
