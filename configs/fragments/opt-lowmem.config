# ---------------------------------------------------------------------------
# opt-lowmem: make the build fit on a small builder.
#
# Two steps in a default build are single-process memory hogs, and a 2GB
# Docker Desktop / colima VM or a small CI runner dies on both:
#
#   * linking vmlinux.o with DEBUG_INFO_BTF -- full DWARF in every object,
#     needs roughly 8GB;
#   * compressing the image with KERNEL_ZSTD, which the kernel invokes as
#     `zstd -22 --ultra` (~1.5GB, and it fails as a plain Error 11).
#
# This trades CO-RE eBPF support and ~15% of image size for a build that fits
# in ~2GB.  Use it for compile tests and smoke tests, not for what you ship:
#   make KVMHOST_EXTRA=opt-lowmem build   # small builder
#   make build                            # fleet image
# ---------------------------------------------------------------------------
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
