# AMD Instinct GPUs for compute (ROCm).
#
# READ THIS BEFORE USING IT.  ROCm goes through amdgpu + amdkfd, which are
# in-tree DRM drivers.  Enabling this turns CONFIG_DRM back on -- the largest
# and most vulnerability-dense subsystem that 90-strip.config removes from
# every other profile in this repo -- plus the amdgpu driver itself, which is
# the single biggest driver in the kernel tree.
#
# That is a deliberate, documented risk acceptance for a dedicated accelerator
# fleet, not something to inherit by accident.  It is why AMD and NVIDIA are
# separate fragments instead of one "GPU" switch:
#
#   - the NVIDIA node keeps the no-DRM posture and pays with out-of-tree
#     modules;
#   - the AMD node keeps everything in-tree and pays with DRM.
#
# Do not run this profile on a node that also hosts tenants.
#
#   make PROFILE=gpu-node GPU=amd build
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_HSA_AMD=y
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y
# Headless: no display output, no framebuffer console on the GPU.
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set

# amdgpu also drags X86_PLATFORM_DEVICES back in (ACPI WMI and friends), which
# 90-strip.config removes everywhere else.  Recorded rather than fought: it is
# one more item on the bill for choosing the in-tree stack.
CONFIG_X86_PLATFORM_DEVICES=y
