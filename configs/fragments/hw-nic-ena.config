# AWS Elastic Network Adapter.  This is the NIC a *guest* sees on EC2 -- the
# Nitro card presents it -- so it belongs to profiles that run as cloud
# instances, not to a bare-metal host profile.
#
#   make PROFILE=worker KVMHOST_NICS=ena build     # worker on EC2
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
