# Intel In-Memory Analytics Accelerator (IAA): hardware DEFLATE compression and
# decompression via the idxd driver (same engine family as DSA).  Opt-in per
# fleet with ACCEL=intel-iaa; self-contained so it works without intel-dsa.
# IAA compression is what makes migrating/snapshotting large guests over a
# shared fabric affordable.
CONFIG_DMADEVICES=y
CONFIG_INTEL_IDXD=y
# SVM hands the device CPU page tables; we refuse that here as elsewhere --
# dedicated work queues with explicit IOVA mappings instead.
# CONFIG_INTEL_IDXD_SVM is not set
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_DEV_IAA_CRYPTO=y
