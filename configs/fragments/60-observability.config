# ---------------------------------------------------------------------------
# 60-observability: what you need at 3am on a host you cannot log into twice.
#
# Everything here is passive-cost: tracers that are patched out until armed,
# BTF for CO-RE eBPF, and a crash path that produces an artifact instead of a
# reboot with no evidence.  Deliberately absent: KASAN, lockdep, and friends
# (see opt-debug.config).
# ---------------------------------------------------------------------------

CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_PERF_EVENTS_AMD_UNCORE=y
CONFIG_PERF_EVENTS_AMD_POWER=y

CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_STACK_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_HIST_TRIGGERS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BLK_DEV_IO_TRACE=y

# CO-RE eBPF needs BTF in the running kernel.  This inflates vmlinux, not
# bzImage; the debug info is stripped out of the boot image.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y

# --- Liveness ---------------------------------------------------------------
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
# BOOTPARAM_SOFTLOCKUP_PANIC changed type between tracks; it lives in the
# per-version fragments (kver-*.config).
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=30

# --- Crash artifacts --------------------------------------------------------
# kdump via kexec_file_load (the old kexec_load syscall stays off: it takes an
# unverified image from userspace, which is exactly what lockdown forbids).
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y
CONFIG_CRASH_HOTPLUG=y
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_JUMP is not set

# Persistent oops storage for the case where kdump itself does not survive.
CONFIG_PSTORE=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_RAM=y
CONFIG_EFI_VARS_PSTORE=y

CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_STACKTRACE=y
CONFIG_UNWINDER_ORC=y
