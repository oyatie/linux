# ---------------------------------------------------------------------------
# layer-control-plane: what a cluster control-plane node needs instead of a
# hypervisor stack.
#
# The workload is a replicated state machine (etcd + apiserver, or a
# Borgmaster) plus the containers it runs.  No VMs, so no KVM, no vhost, no
# VFIO -- roughly 1.5 MiB of code and the entire device-assignment surface
# that a machine running zero guests should not carry.
# ---------------------------------------------------------------------------

# --- Containers -------------------------------------------------------------
# cgroup v2, namespaces, seccomp and overlayfs come from 00-core/20-storage;
# these are the pieces only a container host needs.
# net_cls and net_prio are cgroup *v1* controllers with no v2 equivalent --
# on v2 you classify and prioritise with tc filters and BPF, keyed on the
# cgroup id.  Enabling them on a v1-disabled kernel is dead code that also
# quietly contradicts the v2-only claim.
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_NET_CLS_CGROUP is not set
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_POSIX_MQUEUE=y

# --- Service networking -----------------------------------------------------
# kube-proxy in IPVS mode, or any L4 VIP scheme, needs the IPVS core.
# iptables mode does NOT need CONFIG_IP_NF_IPTABLES: modern userspace is
# iptables-nft, which speaks the nf_tables API this kernel already has.
CONFIG_IP_VS=y
CONFIG_IP_VS_RR=y
CONFIG_IP_VS_WRR=y
CONFIG_IP_VS_SH=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y

# --- Consensus durability ---------------------------------------------------
# The Paxos/Raft log is fsync-bound: every commit is a barrier to stable
# storage, and a stall there is a leader election.  Nothing exotic to enable --
# the point is what is NOT here: no swap (00-core), no THP for the log heap
# (madvise only), and no writeback throttling surprises.
CONFIG_BLK_DEV_INTEGRITY=y

# Remote block storage is wrong for this layer, not merely unnecessary: an
# etcd/Paxos WAL on NVMe-oF couples every commit to the network, turns a
# fabric hiccup into a leader election, and makes the consensus group's
# availability a function of the storage fabric it was supposed to be
# independent of.
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_TCP is not set
# CONFIG_NVME_TCP_TLS is not set
# CONFIG_TLS is not set
