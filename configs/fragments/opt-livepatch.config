# ---------------------------------------------------------------------------
# opt-livepatch: kpatch/klp-style live patching of individual functions.
#
# This REVERSES the no-modules stance in 50-security.config, and that is not a
# detail: a live patch is delivered as a kernel module, so enabling livepatch
# means the module loader exists again.  The trade is deliberate --
#
#   without it: every security fix is a reboot, so urgent fixes queue up
#               behind drain campaigns and machines run known-vulnerable for
#               days;
#   with it:    the module loader is back, and the only thing standing
#               between an attacker and kernel code execution is signature
#               enforcement.
#
# So it is only defensible together with MODULE_SIG_FORCE and lockdown in
# integrity mode (both set here / in 50-security), and with the signing key
# held offline.  Enable per profile:
#     make PROFILE=control-plane KVMHOST_EXTRA=opt-livepatch build
# ---------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set

CONFIG_LIVEPATCH=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_KALLSYMS_ALL=y
