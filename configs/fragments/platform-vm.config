# ---------------------------------------------------------------------------
# platform-vm: this kernel runs INSIDE a virtual machine.
#
# Selected with PLATFORM=vm, orthogonal to the role.  This fragment contains
# ONLY platform concerns -- it says "you do not own the hardware", nothing
# about what the machine is for.  A worker, a control-plane node or a database
# node can all be PLATFORM=vm and keep every capability their role needs.
#
#   PLATFORM=metal  owns the machine: memory errors, the BMC, microcode,
#                   P-states, thermals, and the fleet's real NICs.
#   PLATFORM=vm     owns none of that.  Each of those jobs belongs to the
#                   hypervisor underneath, and a guest that thinks otherwise
#                   is disagreeing with its host about who owns the hardware.
#
# At a hyperscaler the fleet itself is bare metal end to end -- this axis
# exists for the images you hand to tenants, for nested/CI, and for hybrid
# capacity rented from someone else's cloud.
#
# Set the NICs to match: KVMHOST_NICS=none (virtio only) or =ena on EC2.
# ---------------------------------------------------------------------------

# --- Direct boot ------------------------------------------------------------
# The PVH entry point is how Cloud Hypervisor (and optionally Firecracker)
# direct-boot an ELF vmlinux without firmware.  Costs nothing on the bzImage
# path.  (virtio-fs and virtio-iommu are deliberately NOT here: they are a
# Cloud Hypervisor product surface and live in layer-ch-guest.config.)
CONFIG_PVH=y

# --- Guest-side paravirt ----------------------------------------------------
# kvm-clock instead of calibrating a TSC the host is timeslicing; paravirt
# spinlocks so a preempted vCPU does not spin a lock holder into the ground;
# ptp_kvm for a clock the host agrees with.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_PTP_1588_CLOCK_KVM=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- Machine checks: the host owns the silicon ------------------------------
# A guest that thinks it can recover a memory error disagrees with its
# hypervisor about who owns the page.
# CONFIG_X86_MCE is not set
# CONFIG_X86_MCE_INTEL is not set
# CONFIG_X86_MCE_AMD is not set
# CONFIG_X86_MCE_THRESHOLD is not set
# MEMORY_FAILURE depends on MCE on x86 and follows it out.
# CONFIG_MEMORY_FAILURE is not set

# --- RAS and out-of-band management -----------------------------------------
# CONFIG_RAS is not set
# CONFIG_RAS_CEC is not set
# CONFIG_EDAC is not set
# CONFIG_ACPI_APEI is not set
# CONFIG_ACPI_APEI_GHES is not set
# CONFIG_ACPI_APEI_MEMORY_FAILURE is not set
# CONFIG_ACPI_APEI_PCIEAER is not set
# CONFIG_EDAC_GHES is not set
# CONFIG_EDAC_SKX is not set
# CONFIG_EDAC_I10NM is not set
# CONFIG_EDAC_IGEN6 is not set
# CONFIG_EDAC_AMD64 is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_ACPI_IPMI is not set
# CONFIG_IPMI_DEVICE_INTERFACE is not set
# CONFIG_IPMI_SI is not set
# CONFIG_IPMI_WATCHDOG is not set
# CONFIG_WATCHDOG is not set
# CONFIG_WATCHDOG_SYSFS is not set
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
# CONFIG_ITCO_WDT is not set
# A vTPM is exposed differently and rarely used; add it back per fleet.
# CONFIG_TCG_TPM is not set
# CONFIG_TCG_TIS is not set
# CONFIG_TCG_CRB is not set

# --- Power, thermal, telemetry ----------------------------------------------
# A guest does not set frequencies, read package temperatures or cap power.
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_CPU_IDLE_GOV_MENU is not set
# CONFIG_CPU_IDLE_GOV_TEO is not set
# CONFIG_INTEL_IDLE is not set
# CONFIG_POWERCAP is not set
# CONFIG_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_RAPL is not set
# CONFIG_PERF_EVENTS_INTEL_UNCORE is not set
# CONFIG_HWMON is not set
# CONFIG_SENSORS_CORETEMP is not set
# CONFIG_SENSORS_K10TEMP is not set
# CONFIG_NVME_HWMON is not set
# CONFIG_HW_RANDOM_INTEL is not set
# CONFIG_HW_RANDOM_AMD is not set

# --- Physical-platform plumbing ---------------------------------------------
# Cache/bandwidth partitioning is enforced by the host across guests; a guest
# has no view of the real cache to partition.
# CONFIG_X86_CPU_RESCTRL is not set
# The IOMMU belongs to the host.  A guest that needs one uses virtio-iommu
# (layer-ch-guest re-enables IOMMU_SUPPORT for exactly that).  Only the
# prompted symbols are stripped: IOMMU_API/IOMMU_DMA are promptless followers
# and stripping them just collides with a layer's legitimate re-add.
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_INTEL_IOMMU is not set
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set
# CONFIG_AMD_IOMMU is not set
# CONFIG_IRQ_REMAP is not set
# ...and with no IOMMU there is no default domain policy to set.
# CONFIG_IOMMU_DEFAULT_DMA_STRICT is not set
# CONFIG_X86_POSTED_MSI is not set
# PCIe error handling and hotplug are the host's problem.
# CONFIG_PCIEAER is not set
# CONFIG_PCIE_DPC is not set
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_HOTPLUG_PCI_PCIE is not set
# CONFIG_HOTPLUG_PCI_ACPI is not set
# CONFIG_ACPI_PCI_SLOT is not set
# CONFIG_ACPI_HED is not set
# CONFIG_MICROCODE_LATE_LOADING is not set
# CONFIG_EFI_VARS_PSTORE is not set
# CONFIG_PSTORE_RAM is not set

# Cannot be stripped, recorded so nobody re-tries it:
#   MICROCODE  -- def_bool y on any Intel/AMD CPU since 6.6.
#   CPU_FREQ / CPU_IDLE / ACPI_PROCESSOR / ACPI_CPPC_LIB / the schedutil
#     governor, the P-state drivers and THERMAL -- all selected by
#     ACPI_PROCESSOR, which a guest
#     still needs for its virtual CPUs.  Inert under a hypervisor that
#     exposes no P-states, but present.
