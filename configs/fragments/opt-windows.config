# ---------------------------------------------------------------------------
# opt-windows: sell Windows VMs.
#
# Hyper-V enlightenments make Windows guests run measurably better under KVM
# (synthetic timers, SynIC, TLB-flush and IPI hypercalls).  They are off by
# default because a Linux-only pool should not carry a second hypercall ABI.
#   make PROFILE=hypervisor KVMHOST_EXTRA=opt-windows build
# ---------------------------------------------------------------------------
CONFIG_KVM_HYPERV=y
