# ---------------------------------------------------------------------------
# 40-platform: firmware, RAS, out-of-band management, power, telemetry.
#
# This fragment is what separates a "server kernel" from a laptop kernel.  At
# fleet scale the interesting failure is not a crash, it is a machine that
# silently corrupts one tenant's memory.  RAS/EDAC/CEC exist to see that
# happen and turn it into a page offline + a guest kill instead.
# ---------------------------------------------------------------------------

CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIE_DPC=y
CONFIG_PCIE_PME=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_PCI_QUIRKS=y

# --- IOMMU (DMA protection) ---------------------------------------------
# Not a virtualization feature: this is what stops a compromised or buggy
# device from DMA-ing over kernel memory.  Every profile gets it.
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_DMA=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
# DMA invalidation policy, stated for EVERY bare-metal profile rather than
# only the hypervisor.  Lazy invalidation batches IOTLB flushes, which leaves
# a window where a freed IOVA is still DMA-reachable.  That is a reasonable
# throughput trade on a machine you fully trust and an unreasonable one on a
# machine running other people's code -- and the audit found the worker
# silently inheriting LAZY from Kconfig's default, which is exactly the
# machine that must not have it.
#
# Relax per fleet with iommu.strict=0, or wholesale with opt-trusted.config.
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_CPPC_LIB=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_HED=y
CONFIG_ACPI_IPMI=y
CONFIG_ACPI_PCI_SLOT=y
CONFIG_ACPI_NUMA=y
# Attacker-supplied ACPI tables from the initrd: no.
# CONFIG_ACPI_TABLE_UPGRADE is not set

CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFIVAR_FS=y
CONFIG_DMIID=y
CONFIG_DMI_SYSFS=y

# --- RAS --------------------------------------------------------------------
CONFIG_RAS=y
CONFIG_RAS_CEC=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ACPI_APEI_PCIEAER=y
CONFIG_ACPI_APEI_MEMORY_FAILURE=y
CONFIG_EDAC=y
CONFIG_EDAC_GHES=y
CONFIG_EDAC_SKX=y
CONFIG_EDAC_I10NM=y
CONFIG_EDAC_IGEN6=y
CONFIG_EDAC_AMD64=y

# --- Out-of-band management -------------------------------------------------
CONFIG_IPMI_HANDLER=y
CONFIG_IPMI_DEVICE_INTERFACE=y
CONFIG_IPMI_SI=y
CONFIG_IPMI_WATCHDOG=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_ITCO_WDT=y

# --- Measured boot / attestation --------------------------------------------
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_AMD=y
# RANDOM_TRUST_CPU/BOOTLOADER are runtime knobs now (random.trust_cpu=,
# random.trust_bootloader=), not build options.  See docs/TUNING.md.

# --- Power / frequency ------------------------------------------------------
# Governor default is performance: a host whose cores are ramping is a host
# with a p99 problem.  Everything else is available for opportunistic fleets.
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_INTEL_IDLE=y
CONFIG_THERMAL=y
# A hypervisor host never suspends.  It is either serving or it is drained.
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set

# --- Telemetry --------------------------------------------------------------
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_INTEL_RAPL=y
CONFIG_POWERCAP=y

# ACPI power button needs an input device; nothing else does.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
