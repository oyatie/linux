# Per-version overrides for the 6.18 LTS track.
# Applied automatically when KERNEL_VERSION starts with 6.18.
#
# 6.18: BOOTPARAM_SOFTLOCKUP_PANIC is a bool.
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y

# No LIVEUPDATE here: the LTS track has KHO (memory handover) but not the
# Live Update Orchestrator, so tier-2 upgrades can preserve memory but cannot
# hand over live devices.  This is the concrete cost of staying on LTS.

# 6.18's KHO carries `depends on !DEFERRED_STRUCT_PAGE_INIT`, so on this track
# fast boot and live update are mutually exclusive.  Live update wins: a fleet
# that can kexec with handover rarely cold-boots, whereas losing KHO turns
# every kernel CVE into a drain-and-reboot campaign.  7.2 dropped the
# restriction and gets both.
# CONFIG_DEFERRED_STRUCT_PAGE_INIT is not set
# KEXEC_HANDOVER_ENABLE_DEFAULT does not exist here either: put kho=on in the
# boot command line instead.
