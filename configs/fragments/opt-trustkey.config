# opt-trustkey: bake a signing cert into the kernel's built-in trusted keyring.
#
# With this, the running kernel trusts images signed by that cert -- so
# kexec_file_load ACCEPTS a signed next-kernel (KEXEC_SIG, from platform-metal)
# and MODULE_SIG accepts signed modules, both verified against a key compiled
# into vmlinux rather than anything on disk.
#
# The path is resolved at build time inside the container; pki-init.sh writes
# the dev cert to /out/pki/secureboot.crt.  Production points this at the
# fleet CA (and the private key lives in an HSM, never in the build).
CONFIG_SYSTEM_TRUSTED_KEYS="/out/pki/secureboot.crt"
