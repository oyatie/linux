# opt-trustkey: bake the fleet's signing certs into the kernel's built-in
# trusted keyring.  Applied automatically to every METAL profile by build.sh --
# without it SYSTEM_TRUSTED_KEYS is empty, and KEXEC_SIG,
# DM_VERITY_VERIFY_ROOTHASH_SIG and MODULE_SIG_FORCE are enabled but anchored
# to nothing: signed kexec cannot succeed, the signed root hash cannot be
# verified in-kernel, and a "refused" result proves only that no key exists.
#
# The bundle holds BOTH certs the chain verifies against -- the UKI/kexec signer
# and the dm-verity root-hash signer (they are different keys; baking only the
# first is why the roothash path had never actually worked).  pki-init.sh writes
# it; production points this at the fleet CA, whose private keys live in an HSM
# and never touch the build.
CONFIG_SYSTEM_TRUSTED_KEYS="/out/pki/trusted-keys.pem"

# A trust anchor without revocation is a one-way door: enable the blacklist
# keyring so a compromised key/hash can be revoked without shipping a new
# kernel.
CONFIG_SYSTEM_BLACKLIST_KEYRING=y
CONFIG_SYSTEM_REVOCATION_LIST=y
