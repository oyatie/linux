# The kernel this platform is built from, and the floor below which it will
# not build.
#
# There is no LTS track.  The features this platform is built around -- Live
# Update Orchestrator, memfd handover, KHO armed at boot -- do not exist below
# 7.0, so an LTS kernel could not run the design, only a degraded version of
# it.  Rather than maintain a second track that silently loses live update,
# the floor is enforced.
KERNEL_VERSION=7.2

# Minimum supported version, derived (not guessed) by scripts/feature-floor.sh
# from the features this platform actually uses.  Regenerate with `make msv`
# and see docs/MSV.md for the per-feature table.
MSV=7.0
