# Version policy: two tracks, one floor.
#
#   v1 (plant)    -- the current LTS.  This is what boots the cloud on day
#                    one: kexec_file_load + drain for kernel updates, plus
#                    livepatch on VFIO hosts.  Stable trees get ~2 years of
#                    backported fixes; a .0 mainline gets ~2 months.
#   destination   -- mainline with the Live Update Orchestrator (KHO + LUO +
#                    memfd handover), which is what eventually turns a kernel
#                    update into ~1s of blackout instead of a drain campaign.
#                    LUO does not exist below 7.0, so that is the destination
#                    floor, not the plant floor.
#
# `make build` builds the v1 track.  `make KERNEL_VERSION=$(DESTINATION_VERSION) ...`
# builds the destination track; validate-all resolves every shipping profile
# against BOTH so the day we move is a version bump, not a migration.
KERNEL_VERSION=6.18.45
DESTINATION_VERSION=7.2

# Hard floor for any build (v1 feature set: iommufd + VFIO cdev, KVM TDX,
# PREEMPT_LAZY, nftables-only userspace assumptions).  Derived, not guessed:
# scripts/feature-floor.sh, table in docs/MSV.md.
MSV=6.18
# Floor for the live-update fragment (LIVEUPDATE/LIVEUPDATE_MEMFD/KHO armed).
# Below this, host profiles build WITHOUT live update and the update story is
# drain + livepatch -- build.sh says so out loud.
LUO_FLOOR=7.0

# Source integrity: the exact tarball each version must hash to (from
# kernel.org's signed sha256sums.asc).  fetch.sh REFUSES to unpack anything
# else -- without this, every downstream guarantee (Secure Boot, dm-verity,
# signed kexec, the promotion hash-chain) is anchored to whatever HTTPS
# happened to return.  Update deliberately, with the new hash, when bumping.
KERNEL_SHA256=30fa4a56579ca614ac125a12614f7f6466f87ab1278aef7b951dd74156deab33
DESTINATION_SHA256=f9fef3d14c0df53819026f4be74459835c2a0b0dcbf5b5bbd9ea19f0829402b3
